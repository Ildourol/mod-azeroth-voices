#                  raid. (Percentage.)
#     Default:     60
AzerothVoices.GroupChatter.DungeonEntryChance = 60

# AzerothVoices.GroupChatter.DungeonEntryCooldownSeconds
#     Description: Cooldown after a dungeon-entry line. (Seconds, 0-86400.)
#     Default:     300
AzerothVoices.GroupChatter.DungeonEntryCooldownSeconds = 300

# AzerothVoices.GroupChatter.ZoneChangeChance
#     Description: Chance the group comments on an outdoor zone change. (Percentage.)
#     Default:     15
AzerothVoices.GroupChatter.ZoneChangeChance = 15

# AzerothVoices.GroupChatter.ZoneChangeCooldownSeconds
#     Description: Cooldown after a zone-change line. (Seconds, 0-86400.)
#     Default:     300
AzerothVoices.GroupChatter.ZoneChangeCooldownSeconds = 300

# AzerothVoices.GroupChatter.KillChance
#     Description: Chance the group reacts to an ordinary creature kill. (Percentage.)
#     Default:     4
AzerothVoices.GroupChatter.KillChance = 4

# AzerothVoices.GroupChatter.KillCooldownSeconds
#     Description: Cooldown after a trash-kill line. (Seconds, 0-86400.)
#     Default:     600
AzerothVoices.GroupChatter.KillCooldownSeconds = 600

# AzerothVoices.GroupChatter.BossPullChance
#     Description: Chance the group reacts when a classified dungeon/raid boss is
#                  engaged. (Percentage.)
#     Default:     50
AzerothVoices.GroupChatter.BossPullChance = 50

# AzerothVoices.GroupChatter.BossPullCooldownSeconds
