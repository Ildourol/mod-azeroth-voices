###################################################################################################
# Azeroth Voices - provider-neutral LLM chat for TortoiseWoW/vMaNGOS
###################################################################################################

[worldserver]

#
# This is a TortoiseWoW/vMaNGOS worldserver module configuration.
# Legacy AiPlayerbot.LLM* names are retained where their meaning is compatible.
# The module does not read etc/aiplayerbot.conf automatically: copy wanted compatible values here.
# Percentages use 0 (never) through 100 (always) and are clamped to that range.

###################################################################################################
# Module ownership and diagnostics
###################################################################################################

# Type: Boolean (0/1); default 1. Master switch for every module feature and HTTP request.
AzerothVoices.Enable = 1
# Type: Boolean (0/1); default 0. Logs queue, provider, scheduling, and delivery diagnostics.
AzerothVoices.Debug = 0
# Type: Boolean (0/1); default 0. Logs full prompts; may expose whispers/history, so use temporarily.
AzerothVoices.TracePrompts = 0

###################################################################################################
# Provider and HTTPS
###################################################################################################

# Type: Enum ChatCompletions/Responses; default ChatCompletions. Selects generated request shape.
# ChatCompletions supports OpenAI, Gemini's OpenAI-compatible endpoint, OpenRouter, and gateways.
AzerothVoices.ProviderMode = ChatCompletions
# Type: URL; default OpenAI chat/completions. Full provider endpoint. Remote plain HTTP is rejected.
AiPlayerbot.LLMApiEndpoint = https://api.openai.com/v1/chat/completions
# Type: Secret or env:VARIABLE; default env:OPENAI_API_KEY. Supplies the Bearer API token.
AiPlayerbot.LLMApiKey = env:OPENAI_API_KEY
# Type: String; default gpt-4.1-mini. Exact model identifier accepted by the selected endpoint.
AzerothVoices.Model = gpt-4.1-mini
# Type: JSON template; default empty. Empty generates safe JSON; non-empty migrates an old template.
# Supports <pre prompt>, <context>, <prompt>, <model>, and normal documented placeholders.
AiPlayerbot.LLMApiJson =
# Type: Enum ProviderJson/LegacyRegex; default ProviderJson. Selects response parsing strategy.
# ProviderJson understands OpenAI chat/Responses, Gemini candidates, and Ollama response JSON.
AzerothVoices.ParserMode = ProviderJson
# Type: File path; default empty. Empty uses system CAs; otherwise uses this custom CA bundle.
AzerothVoices.CACertFile =
# Type: Boolean; default 1. Allows plain HTTP only for local/loopback providers, never remote HTTP.
AzerothVoices.AllowLocalHttp = 1
# Type: Integer seconds, minimum 1; default 10. TCP/TLS connection timeout.
AzerothVoices.ConnectTimeoutSeconds = 10
# Type: Integer seconds, minimum 1; default 60. Provider read/write generation timeout.
AiPlayerbot.LLMGenerationTimeout = 60
# Type: Integer bytes, minimum 1024; default 65536. Rejects oversized HTTP responses.
AzerothVoices.MaxResponseBytes = 65536
# Type: Integer tokens, minimum 1; default 80. Requested output limit in generated provider JSON.
AzerothVoices.MaxTokens = 80
# Type: Decimal 0.0-2.0; default 0.8. Sampling randomness; invalid values are clamped.
AzerothVoices.Temperature = 0.8
# Type: Decimal 0.0-1.0; default 0.95. Nucleus sampling; invalid values are clamped.
AzerothVoices.TopP = 0.95

###################################################################################################
# Worker pool, queue, limits, and cooldowns
###################################################################################################

# Type: Integer 1-32; default 8. Fixed background HTTP workers; core objects stay on world thread.
AzerothVoices.WorkerThreads = 8
# Type: Integer 1-32; default 8. Legacy misspelled fallback used only if WorkerThreads is absent.
AiPlayerbot.LLMMaxSimultaniousGenerations = 8
# Type: Integer requests, minimum 1; default 128. Hard pending-queue memory bound.
AzerothVoices.QueueMaximum = 128
# Type: Integer 0-QueueMaximum; default 32. Queue capacity reserved for direct/group replies.
AzerothVoices.HighPriorityReserve = 32
# Type: Integer requests/minute, minimum 1; default 60. Global budget shared by all workers.
AzerothVoices.GlobalRequestsPerMinute = 60
# Type: Integer seconds, minimum 1; default 90. Drops queued requests that are no longer timely.
AzerothVoices.RequestTTLSeconds = 90
# Type: Integer seconds, minimum 0; default 10. Cooldown before an actor gives another normal reply.
AzerothVoices.ActorCooldownSeconds = 10
# Type: Integer seconds, minimum 0; default 120. Longer per-actor random-chatter cooldown.
AzerothVoices.AmbientActorCooldownSeconds = 120
# Type: Integer seconds, minimum 0; default 3. Coalesces rapid non-whispers from one speaker.
AzerothVoices.SpeakerCooldownSeconds = 3
# Type: Integer retries, minimum 0; default 1. Retries transient connection, 429, and 5xx failures.
AzerothVoices.RetryMaximum = 1
# Type: Integer milliseconds, minimum 0; default 500. Base increasing delay between retries.
AzerothVoices.RetryBackoffMilliseconds = 500

###################################################################################################
# Shared prompts and PlayerBots-compatible prompt names
###################################################################################################

# Type: Text; default below. One shared personality/behavior prompt for every bot and NPC.
# Azeroth Voices deliberately has no individual character-card personalities.
AzerothVoices.GlobalPrompt = You create short, natural in-game dialogue for World of Warcraft. Stay in the game world. Never mention AI, prompts, policies, APIs, or being a narrator. Return only what the speaker says.
# Type: Text template; default below. Describes a PlayerBot before a normal response.
AiPlayerbot.LLMPrePrompt = You are <bot name>, a level <bot level> <bot race> <bot class> in <bot subzone>, <bot zone>.
# Type: Text template; default below. Formats incoming chat for the provider.
AiPlayerbot.LLMPrompt = <receiver name>: <initial message>
# Type: Text template; default below. Adds a short response cue after incoming chat.
AiPlayerbot.LLMPostPrompt = <bot name>:
# Type: Text template; default below. Shared prompt for a nearby NPC speaker.
AiPlayerbot.LLMRpgPrompt = You are <bot name>, an NPC in <bot subzone>, <bot zone>. Reply briefly in character.
# Type: Integer characters, minimum 0; default 4096. Bounds live/history/knowledge context.
AiPlayerbot.LLMContextLength = 4096
# Type: Boolean; default 0. 0 isolates history by speaker/scope; 1 shares actor-wide history.
AiPlayerbot.LLMGlobalContext = 0
# Type: File path; default empty. Accepted for migration diagnostics but intentionally not loaded.
AiPlayerbot.LLMDefaultPromptsFile =
# Type: ECMAScript regex; default below. LegacyRegex-only response start matcher.
AiPlayerbot.LLMResponseStartPattern = ("content":\s*")
# Type: ECMAScript regex; default below. LegacyRegex-only response end matcher.
AiPlayerbot.LLMResponseEndPattern = ("|\b(?!<sender name>\b)(\w+):)
# Type: ECMAScript regex; default below. LegacyRegex-only unwanted-fragment remover.
AiPlayerbot.LLMResponseDeletePattern = (\\n|<sender name>:|\\[^ ]+)
# Type: ECMAScript regex; default empty. Optional LegacyRegex multi-line split matcher.
AiPlayerbot.LLMResponseSplitPattern =
# Type: Comma-separated scope/channel names; default empty. Blocks matching replies, ignoring case.
AiPlayerbot.LLMBlockedReplyChannels =

###################################################################################################
# Chat scopes, NPCs, distances, and response selection
###################################################################################################

# Type: Boolean; default 1. Enables direct PlayerBot whisper replies.
AzerothVoices.Replies.Whisper = 1
# Type: Boolean; default 1. Enables nearby PlayerBot and eligible friendly NPC say replies.
AzerothVoices.Replies.Say = 1
# Type: Boolean; default 1. Enables nearby PlayerBot and eligible friendly NPC yell replies.
AzerothVoices.Replies.Yell = 1
# Type: Boolean; default 1. Enables PlayerBot party-subgroup replies.
AzerothVoices.Replies.Party = 1
# Type: Boolean; default 1. Enables PlayerBot raid replies.
AzerothVoices.Replies.Raid = 1
# Type: Boolean; default 1. Enables guild replies, guild ambient chatter, and guild events.
AzerothVoices.Replies.Guild = 1
# Type: Boolean; default 0. Enables officer-channel replies for suitably ranked bots.
AzerothVoices.Replies.Officer = 0
# Type: Boolean; default 1. Enables replies and ambient/event lines in WorldChannelName.
AzerothVoices.Replies.World = 1
# Type: Boolean; default 0. Enables replies in channels other than WorldChannelName.
AzerothVoices.Replies.CustomChannels = 0
# Type: Channel name; default World. Used to classify and deliver world-chat messages.
AzerothVoices.WorldChannelName = World
# Type: Boolean; default 1. Allows alive friendly non-pet/non-totem/non-critter NPC speakers.
AzerothVoices.NPC.Enable = 1
# Type: Decimal yards, minimum 1; default 25. Search distance for eligible NPC speakers.
AzerothVoices.NPC.Distance = 25
# Type: Boolean; default 1. Prevents actors currently in combat from being selected.
AzerothVoices.DisableRepliesInCombat = 1
# Type: Integer actors, minimum 1; default 2. Maximum responders to one incoming message.
AzerothVoices.MaxResponders = 2
# Type: Decimal yards, minimum 1; default 30. Local say listener/responder distance.
AzerothVoices.SayDistance = 30
# Type: Decimal yards, minimum SayDistance; default 100. Local yell listener/responder distance.
AzerothVoices.YellDistance = 100

# Type: Percentage; default 100. Chance a selected or directly whispered actor answers.
AzerothVoices.Chance.DirectAddress = 100
# Type: Percentage; default 70. Chance an actor named in the message answers.
AzerothVoices.Chance.NameMention = 70
# Type: Percentage; default 8. Chance an otherwise eligible nearby actor joins in.
AzerothVoices.Chance.Overhear = 8
# Type: Percentage; default 90. Bot response chance to a real player's say/yell.
AzerothVoices.PlayerReplyChance.Say = 90
# Type: Percentage; default 10. Bot response chance to another bot's say/yell.
AzerothVoices.BotReplyChance.Say = 10
# Type: Percentage; default 60. Bot response chance to a real player in world/custom chat.
AzerothVoices.PlayerReplyChance.Channel = 60
# Type: Percentage; default 3. Bot response chance to another bot in world/custom chat.
AzerothVoices.BotReplyChance.Channel = 3
# Type: Percentage; default 90. Bot response chance to a real player in party/raid.
AzerothVoices.PlayerReplyChance.Party = 90
# Type: Percentage; default 25. Bot response chance to another bot in party/raid.
AzerothVoices.BotReplyChance.Party = 25
# Type: Percentage; default 70. Bot response chance to a real player in guild/officer chat.
AzerothVoices.PlayerReplyChance.Guild = 70
# Type: Percentage; default 5. Bot response chance to another bot in guild/officer chat.
AzerothVoices.BotReplyChance.Guild = 5
# Type: Percentage; default 10. Global upper cap for all PlayerBot-to-PlayerBot replies.
AiPlayerbot.LLMBotToBotChatChance = 10
# Type: Percentage; default 30. Global upper cap for NPC replies to PlayerBot messages.
AiPlayerbot.LLMRpgAIChatChance = 30
# Type: Comma-separated case-insensitive prefixes; default below. Skips commands/addon chatter.
# Add any local PlayerBots or addon prefixes that should never be sent to the provider.
AzerothVoices.CommandBlacklist = .,! ,/,autogear,talents,summon,release,revive,attack,follow,stay,cast,quest,trainer,teleport,addon,DBM,Recount,Questie

###################################################################################################
# Random nearby, guild, and world chatter
###################################################################################################

# Type: Boolean; default 1. Enables scheduled ambient chatter around online real players.
AzerothVoices.Random.Enable = 1
# Type: Integer seconds, minimum 5; default 90. Lower bound before the next ambient attempt.
AzerothVoices.Random.MinimumIntervalSeconds = 90
# Type: Integer seconds, at least MinimumIntervalSeconds; default 240. Upper interval bound.
AzerothVoices.Random.MaximumIntervalSeconds = 240
# Type: Decimal yards, minimum 1; default 150. Local speaker search radius around a real player.
AzerothVoices.Random.RealPlayerDistance = 150
# Type: Percentage; default 15. Chance another actor replies to an ambient generated line.
AzerothVoices.Random.FollowupChance = 15
# Type: Integer generated turns, minimum 1; default 2. Ambient chain cap; 1 disables follow-ups.
AzerothVoices.Random.MaximumActors = 2
# Type: Comma-separated say/yell/guild/officer/world/channel; default say,guild,world.
# Chooses ambient scopes; disabled/unavailable group scopes safely fall back to say.
AzerothVoices.Random.Scopes = say,guild,world
# Type: Pipe-separated text choices; default below. General ambient topic instructions.
AzerothVoices.Random.Prompts = Make a casual observation about the current zone.|Complain briefly about leveling or grinding.|Comment on loot, repairs, travel, professions, quests, dungeons, or battlegrounds.|Make a short joke that fits World of Warcraft.|Mention what you want to do next in the game.
# Type: Pipe-separated text choices; default below. Question-style ambient instructions.
AzerothVoices.Random.Questions = Ask whether anyone wants to group.|Ask for an opinion about the current zone.|Ask which dungeon people like.|Ask what people are farming.|Ask about professions, gear, or PvP.
# Type: Pipe-separated text choices; default below. Instructions that use live surroundings.
AzerothVoices.Random.EnvironmentPrompts = React to something nearby.|Comment on the weather or surroundings.|Mention a creature, object, quest, spell, item, vendor, dungeon, or unfinished task that fits the location.
# Type: Pipe-separated text choices; default below. Topics used for guild ambient chatter.
AzerothVoices.Random.GuildPrompts = Ask whether guild members want a dungeon group.|Congratulate the guild on recent progress.|Talk about raids, PvP, professions, loot, the guild bank, or helping another member.
# Type: Pipe-separated text choices; default below. Topics used for world/channel ambient chatter.
AzerothVoices.Random.WorldPrompts = Start a short world-chat topic about zones, dungeons, loot, professions, PvP, quests, travel, or server life.|Ask world chat a brief useful question.|Make a short public observation that could start a conversation.

###################################################################################################
# Lightweight live environment context
###################################################################################################

# Type: Boolean; default 1. Adds map/zone/area/dungeon/combat/group/guild and bounded context.
AzerothVoices.Environment.Enable = 1
# Type: Decimal yards, minimum 1; default 25. Radius for nearby friendly creature names.
AzerothVoices.Environment.Distance = 25
# Type: Integer entries, minimum 0; default 5. Maximum nearby creature names; 0 disables them.
AzerothVoices.Environment.MaximumCreatures = 5
# Type: Integer entries, minimum 0; default 8. Combined equipment/backpack item-name cap.
AzerothVoices.Environment.MaximumItems = 8
# Type: Boolean; default 1. Includes bounded PlayerBot equipment names in context.
AzerothVoices.Environment.IncludeEquipment = 1
# Type: Boolean; default 0. Includes bounded backpack names; off keeps prompts lightweight.
AzerothVoices.Environment.IncludeBackpack = 0

###################################################################################################
# Event chatter
###################################################################################################
#
# Automatic vMaNGOS hooks: creature/player kill, death, loot, quest complete, spell learned,
# duel request/start/win, level-up, login, guild join, and guild leave.
# Adapter events: achievement, pet_defeated, used_object, guild promotion/demotion,
# dungeon_completed, and game_event_started/stopped. See README.md for HandleEvent examples.
# Guild-related events use guild chat when membership is available; game events use World.

# Type: Boolean; default 1. Master switch for automatic and adapter event reactions.
AzerothVoices.Events.Enable = 1
# Type: Decimal yards, minimum 1; default 40. Radius for local-say event responders only.
AzerothVoices.Events.RealPlayerDistance = 40
# Type: Percentage; default 25. Second-stage chance that other actors react to an event.
AzerothVoices.Events.ResponderChance = 25
# Type: Percentage; default 5. Chance an AI PlayerBot comments on its own event.
AzerothVoices.Events.SelfCommentChance = 5
# Type: Integer actors, minimum 1; default 2. Maximum other responders to one event.
AzerothVoices.Events.MaximumResponders = 2
# Type: Integer seconds, minimum 0; default 60. Per-subject/per-event repeat cooldown.
AzerothVoices.Events.CooldownSeconds = 60
# Type: Percentage; default 8. Initial chance for an automatic creature-kill event.
AzerothVoices.Events.Chance.CreatureDefeated = 8
# Type: Percentage; default 40. Initial chance for an automatic PvP-kill event.
AzerothVoices.Events.Chance.PlayerDefeated = 40
# Type: Percentage; default 25. Initial chance for an automatic player-death event.
AzerothVoices.Events.Chance.Died = 25
# Type: Percentage; default 8. Initial chance for automatic non-rare loot chatter.
AzerothVoices.Events.Chance.ItemLooted = 8
# Type: Percentage; default 25. Initial chance for automatic quest-completion chatter.
AzerothVoices.Events.Chance.QuestCompleted = 25
# Type: Percentage; default 15. Initial chance for automatic spell-learning chatter.
AzerothVoices.Events.Chance.SpellLearned = 15
# Type: Percentage; default 25. Initial chance for automatic duel-request chatter.
AzerothVoices.Events.Chance.DuelRequested = 25
# Type: Percentage; default 20. Initial chance for automatic duel-start chatter.
AzerothVoices.Events.Chance.DuelStarted = 20
# Type: Percentage; default 35. Initial chance for automatic duel-victory chatter.
AzerothVoices.Events.Chance.DuelWon = 35
# Type: Percentage; default 50. Initial chance for level-up chatter; guild scope if available.
AzerothVoices.Events.Chance.LevelUp = 50
# Type: Percentage; default 60. Initial chance for automatic guild-join chatter.
AzerothVoices.Events.Chance.GuildJoin = 60
# Type: Percentage; default 40. Initial chance for guild-leave chatter; falls back to say if cleared.
AzerothVoices.Events.Chance.GuildLeave = 40
# Type: Percentage; default 10. Initial chance for automatic guild-login chatter.
AzerothVoices.Events.Chance.GuildLogin = 10
# Type: Percentage; default 50. Initial chance for adapter-supplied guild promotion.
AzerothVoices.Events.Chance.GuildPromotion = 50
# Type: Percentage; default 30. Initial chance for adapter-supplied guild demotion.
AzerothVoices.Events.Chance.GuildDemotion = 30
# Type: Percentage; default 60. Initial chance for adapter-supplied achievement chatter.
AzerothVoices.Events.Chance.Achievement = 60
# Type: Percentage; default 20. Initial chance for adapter-supplied pet-defeat chatter.
AzerothVoices.Events.Chance.PetDefeated = 20
# Type: Percentage; default 10. Initial chance for adapter-supplied object-use chatter.
AzerothVoices.Events.Chance.UsedObject = 10
# Type: Percentage; default 45. Initial chance for automatic rare-loot guild chatter.
AzerothVoices.Events.Chance.RareItem = 45
# Type: Percentage; default 75. Initial chance for automatic epic-loot guild chatter.
AzerothVoices.Events.Chance.EpicItem = 75
# Type: Percentage; default 70. Initial chance for adapter-supplied dungeon completion.
AzerothVoices.Events.Chance.DungeonCompleted = 70
# Type: Percentage; default 50. Initial chance for adapter game-event start in World.
AzerothVoices.Events.Chance.GameEventStarted = 50
# Type: Percentage; default 30. Initial chance for adapter game-event stop in World.
AzerothVoices.Events.Chance.GameEventStopped = 30

###################################################################################################
# Reply length and PlayerBots-compatible typing delay
###################################################################################################

# Type: Boolean; default 1. Delays delivery so generated chat appears naturally typed.
AzerothVoices.Typing.Enable = 1
# Type: Integer milliseconds, minimum 0; default 0. Fixed delay added to each line.
AzerothVoices.Typing.BaseDelayMilliseconds = 0
# Type: Integer ms/character, minimum 0; default 200. Main natural typing delay.
AzerothVoices.Typing.DelayPerCharacterMilliseconds = 200
# Type: Boolean; default 1. Counts provider generation as elapsed typing time.
# This preserves the restored working PlayerBots delay behavior.
AzerothVoices.Typing.SubtractGenerationTime = 1
# Type: Integer characters, minimum 1; default 220. Truncates cleaned in-game output.
AzerothVoices.Reply.MaximumCharacters = 220
# Type: Integer lines, minimum 1; default 3. Maximum delivered lines per request.
AzerothVoices.Reply.MaximumLines = 3

###################################################################################################
# Bounded in-memory chat history
###################################################################################################

# Type: Boolean; default 1. Keeps short memory only in RAM; no database writes.
AzerothVoices.History.Enable = 1
# Type: Integer turns, minimum 0; default 6. Recent exchanges per history key; 0 keeps none.
AzerothVoices.History.MaximumTurns = 6
# Type: Integer minutes, minimum 1; default 30. Expires inactive conversation histories.
AzerothVoices.History.TTLMinutes = 30
# Type: Integer characters, minimum 128; default 2500. Hard rendered-history size cap.
AzerothVoices.History.MaximumCharacters = 2500
# Type: Text template; default below. Introduces previous conversation context.
AzerothVoices.History.HeaderTemplate = Recent conversation with <sender name>, use it only as context:
# Type: Text template with \n escapes; default below. Renders each stored exchange.
AzerothVoices.History.LineTemplate = <sender name>: <sender message>\n<bot name>: <bot reply>\n
# Type: Text template; default below. Separates history from the new incoming message.
AzerothVoices.History.FooterTemplate = New message from <sender name>: <initial message>

###################################################################################################
# Optional lightweight knowledge retrieval (no Python, embeddings, or database)
###################################################################################################

# Type: Boolean; default 0. Enables local keyword-based knowledge lookup.
AzerothVoices.Knowledge.Enable = 0
# Type: File path; default modules/azeroth_voices_knowledge.txt. Reads keyword|text lines.
AzerothVoices.Knowledge.File = modules/azeroth_voices_knowledge.txt
# Type: Integer entries, minimum 1; default 3. Maximum matching lines per prompt.
AzerothVoices.Knowledge.MaximumItems = 3
# Type: Integer keyword matches, minimum 1; default 1. Inclusion threshold per entry.
AzerothVoices.Knowledge.MinimumScore = 1
# Type: Text template with optional \n; default below. <knowledge> becomes retrieved text.
AzerothVoices.Knowledge.PromptTemplate = Relevant optional world knowledge:\n<knowledge>
