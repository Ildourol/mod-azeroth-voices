AzerothVoices.GuildChatter.PlayerReplies.FirstDelayMinSeconds = 2

# AzerothVoices.GuildChatter.PlayerReplies.FirstDelayMaxSeconds
#     Description: Maximum delay before the first guild reply line is delivered.
#                  (Seconds, 0-60.)
#     Default:     6
AzerothVoices.GuildChatter.PlayerReplies.FirstDelayMaxSeconds = 6

# --------------------------------------------
# 13. DETERMINISTIC BOT MEMORY LEDGER
# --------------------------------------------
#
# C++ writes short fixed-template memories from verified facts only: no provider
# call is made and no player-written text is ever stored. Memories are per
# bot/player pair, they feed a bounded prompt block, and both the Chatter addon's
# Forget button and `.av memory forget` delete them.
# --------------------------------------------

# AzerothVoices.Memory.Enable
#     Description: Enables the memory ledger.
#     Default:     1
AzerothVoices.Memory.Enable = 1

# AzerothVoices.Memory.CacheMaximumPairs
#     Description: Hot-cache bound for loaded bot/player memory pairs. (Pairs,
#                  1-100000.)
#     Default:     4096
AzerothVoices.Memory.CacheMaximumPairs = 4096

# AzerothVoices.Memory.MaximumPerPair
#     Description: Newest rows kept per bot/player pair; older rows are pruned on write.
#                  (Rows, 1-200.)
#     Default:     30
AzerothVoices.Memory.MaximumPerPair = 30

# AzerothVoices.Memory.RetentionDays
#     Description: Age after which untouched rows are deleted by the hourly cleanup.
#                  (Days, 1-3650.)
#     Default:     180
AzerothVoices.Memory.RetentionDays = 180

# AzerothVoices.Memory.MaximumPromptItems
#     Description: Memories injected into one prompt. (Items, 1-20.)
#     Default:     3
AzerothVoices.Memory.MaximumPromptItems = 3

# AzerothVoices.Memory.MaximumPromptCharacters
#     Description: Character cap for the injected memory block, charged to the context
#                  budget below personality. (Characters, 64-4000.)
#     Default:     600
AzerothVoices.Memory.MaximumPromptCharacters = 600

# AzerothVoices.Memory.RecallChance
#     Description: Chance an ambient or group line draws on a memory at all; direct
#                  conversations may always use one. (Percentage.)
#     Default:     15
AzerothVoices.Memory.RecallChance = 15

# AzerothVoices.Memory.FirstMetChance
#     Description: Chance a first meeting in the same group becomes a durable memory.
#                  (Percentage.)
#     Default:     20
AzerothVoices.Memory.FirstMetChance = 20

# AzerothVoices.Memory.PartyMemberChance
#     Description: Chance joining a real player's group becomes a memory. (Percentage.)
#     Default:     25
AzerothVoices.Memory.PartyMemberChance = 25

# AzerothVoices.Memory.QuestCompletedChance
#     Description: Chance completing a quest while grouped becomes a memory.
#                  (Percentage.)
#     Default:     25
AzerothVoices.Memory.QuestCompletedChance = 25

# AzerothVoices.Memory.BossKillChance
#     Description: Chance a classified boss kill while grouped becomes a memory.
#                  (Percentage.)
#     Default:     50
AzerothVoices.Memory.BossKillChance = 50

# AzerothVoices.Memory.PvpKillChance
#     Description: Chance a PvP kill while grouped becomes a memory. (Percentage.)
#     Default:     20
AzerothVoices.Memory.PvpKillChance = 20

# AzerothVoices.Memory.WipeChance
#     Description: Chance a wipe becomes a memory for every grouped bot. (Percentage.)
#     Default:     50
AzerothVoices.Memory.WipeChance = 50

# AzerothVoices.Memory.LevelUpChance
#     Description: Chance a level-up while grouped becomes a memory. (Percentage.)
#     Default:     40
AzerothVoices.Memory.LevelUpChance = 40

# AzerothVoices.Memory.DungeonCompletedChance
#     Description: Chance leaving an instance after at least one boss kill becomes a "we
#                  cleared this" memory. (Percentage.)
#     Default:     30
AzerothVoices.Memory.DungeonCompletedChance = 30

# AzerothVoices.Memory.DatabaseFlushSeconds
#     Description: Coalesced memory write interval. (Seconds, 1-3600.)
#     Default:     5
AzerothVoices.Memory.DatabaseFlushSeconds = 5

# AzerothVoices.Memory.DatabaseFlushBatchSize
#     Description: Rows per normal memory flush batch. (Rows, 1-1000.)
#     Default:     50
AzerothVoices.Memory.DatabaseFlushBatchSize = 50

# --------------------------------------------
# 14. RANDOM NEARBY, GUILD, AND WORLD CHATTER
# --------------------------------------------

# AzerothVoices.Random.Enable
#     Description: Enables scheduled ambient chatter around online real players.
#     Default:     1
AzerothVoices.Random.Enable = 1

# AzerothVoices.Random.MinimumIntervalSeconds
#     Description: Lower bound before the next ambient attempt. (Seconds, minimum 5.)
#     Default:     300
AzerothVoices.Random.MinimumIntervalSeconds = 300

# AzerothVoices.Random.MaximumIntervalSeconds
#     Description: Upper interval bound. (Seconds, at least MinimumIntervalSeconds.)
#     Default:     600
AzerothVoices.Random.MaximumIntervalSeconds = 600

# AzerothVoices.Random.FollowupChance
#     Description: Chance another actor replies after ambient chatter, a bot-originated
#                  Say/Yell/group/guild/world/custom reaction, or an event line; the
#                  corresponding bot-to-bot or RPG interaction cap is then applied.
#                  Every follow-up repeats the selected scope's real-audience rule.
#                  (Percentage.)
#     Default:     10
AzerothVoices.Random.FollowupChance = 10

# AzerothVoices.Random.MaximumActors
#     Description: Generated conversation chain cap; 1 disables follow-ups. (Generated
#                  turns, minimum 1.)
#     Default:     2
AzerothVoices.Random.MaximumActors = 2

# AzerothVoices.Random.Scopes
#     Description: Chooses ambient-chat delivery scopes; a disabled or unavailable group
#                  scope safely falls back to Say. Party is used only when Random
#                  selects Party and requires the selected PlayerBot to share a subgroup
#                  with an online real player. Ordinary Say chatter is owned by the
#                  proximity subsystem (AzerothVoices.Proximity.*); a legacy `say` entry
#                  here is routed through that proximity gate instead of the generic NPC
#                  path so one Random roll cannot make the same NPC speak twice. Yell
#                  uses YellDistance, raid and guild/officer use real membership, World
#                  requires one online real player, and channel uses the custom-channel
#                  audience gate. (Comma-separated
#                  say/yell/party/raid/guild/officer/world/channel.)
#     Default:     guild,world,party
AzerothVoices.Random.Scopes = guild,world,party

# AzerothVoices.Random.Prompts
#     Description: General ambient topic instructions. (Pipe-separated text choices.)
AzerothVoices.Random.Prompts = Make a casual observation about the current zone.|Complain briefly about leveling or grinding.|Comment on loot, repairs, travel, professions, quests, dungeons, or battlegrounds.|Make a short joke that fits World of Warcraft.|Mention what you want to do next in the game.

# AzerothVoices.Random.Questions
#     Description: Question-style ambient instructions. (Pipe-separated text choices.)
AzerothVoices.Random.Questions = Ask whether anyone wants to group.|Ask for an opinion about the current zone.|Ask which dungeon people like.|Ask what people are farming.|Ask about professions, gear, or PvP.

# AzerothVoices.Random.EnvironmentPrompts
#     Description: Instructions that use live surroundings. (Pipe-separated text
#                  choices.)
AzerothVoices.Random.EnvironmentPrompts = React to something nearby.|Comment on the weather or surroundings.|Mention a creature, object, quest, spell, item, vendor, dungeon, or unfinished task that fits the location.

# AzerothVoices.Random.GuildPrompts
#     Description: Topics used for guild ambient chatter. (Pipe-separated text choices.)
AzerothVoices.Random.GuildPrompts = Ask whether guild members want a dungeon group.|Congratulate the guild on recent progress.|Talk about raids, PvP, professions, loot, the guild bank, or helping another member.

# AzerothVoices.Random.WorldPrompts
#     Description: Topics used for world/channel ambient chatter. (Pipe-separated text
#                  choices.)
AzerothVoices.Random.WorldPrompts = Start a short world-chat topic about zones, dungeons, loot, professions, PvP, quests, travel, or server life.|Ask world chat a brief useful question.|Make a short public observation that could start a conversation.

# --------------------------------------------
# 15. AUTOMATED WORLD/CUSTOM-CHANNEL PACING
# --------------------------------------------

# AzerothVoices.GeneralChat.Pacing.Enable
#     Description: Paces automated World and custom-channel chatter so concurrent
#                  exchanges cannot arrive as one wall of text. Only this module's
#                  scheduled ambient World/custom-channel lines are paced; direct
#                  player-directed replies stay immediate, and combat-start, event,
#                  boss, and dungeon/raid reactions are never delayed by this timeline.
#     Default:     1
AzerothVoices.GeneralChat.Pacing.Enable = 1

# AzerothVoices.GeneralChat.MinimumGapSeconds
#     Description: Minimum gap after a reserved multi-line exchange on the same
#                  normalized channel plus zone or map/instance identity. (Seconds,
#                  0-86400.)
#     Default:     15
AzerothVoices.GeneralChat.MinimumGapSeconds = 15

# AzerothVoices.General.Enable
#     Description: Dedicated General/World ambient chatter system ported from mod-llm-
#                  chatter. Enables periodic ambient chatter in General/World channels
#                  where real players are present.
#     Default:     1
AzerothVoices.General.Enable = 1

# AzerothVoices.General.TriggerIntervalSeconds
#     Description: Interval between General chatter trigger evaluation passes across
#                  zones with players. (Seconds, minimum 5.)
#     Default:     30
AzerothVoices.General.TriggerIntervalSeconds = 30

# AzerothVoices.General.TriggerChance
#     Description: Base percent chance per zone to trigger a chatter event during an
#                  evaluation pass. (0-100.)
#     Default:     15
AzerothVoices.General.TriggerChance = 15

# AzerothVoices.General.CityMultiplier
#     Description: Multiplier applied to trigger chance in major capital cities
#                  (Stormwind, Ironforge, Orgrimmar, etc.). (1-10.)
#     Default:     2
AzerothVoices.General.CityMultiplier = 2

# AzerothVoices.General.ConversationChance
#     Description: Chance that a triggered chatter event becomes a two-bot conversation
#                  instead of a solo observation. (0-100.)
#     Default:     40
AzerothVoices.General.ConversationChance = 40

# AzerothVoices.General.NpcGossipChance
#     Description: Chance that the chosen topic gossips about a nearby alive NPC in the
#                  zone. (0-100.)
#     Default:     5
AzerothVoices.General.NpcGossipChance = 5

# AzerothVoices.General.BotGossipChance
#     Description: Chance that the chosen topic gossips about another bot in the same
#                  zone. (0-100.)
#     Default:     5
AzerothVoices.General.BotGossipChance = 5

# AzerothVoices.General.GossipTargetCooldownSeconds
#     Description: Cooldown before the same NPC or bot can be picked as a gossip subject
#                  again. (Seconds.)
#     Default:     1800
AzerothVoices.General.GossipTargetCooldownSeconds = 1800

# AzerothVoices.General.BotSpeakerCooldownSeconds
#     Description: Cooldown before the same bot can speak or participate in General
#                  channel ambient chatter again. (Seconds.)
#     Default:     900
AzerothVoices.General.BotSpeakerCooldownSeconds = 900

# --------------------------------------------
# 16. PARTYGATE PER-PARTY DELIVERY PACING
# --------------------------------------------

# AzerothVoices.PartyGate.Enable
#     Description: Enables per-party delivery timeline pacing and trigger-based policy
#                  gating.
#     Default:     1
AzerothVoices.PartyGate.Enable = 1

# AzerothVoices.PartyGate.FillerMinGapSeconds
#     Description: Minimum gap between filler chatter messages in the same party.
#                  (Seconds, 0-300.)
#     Default:     30
AzerothVoices.PartyGate.FillerMinGapSeconds = 30

# AzerothVoices.PartyGate.ContextualMinGapSeconds
#     Description: Minimum gap between contextual event chatter messages in the same
#                  party. (Seconds, 0-300.)
#     Default:     20
AzerothVoices.PartyGate.ContextualMinGapSeconds = 20

# AzerothVoices.PartyGate.ResponsiveMinGapSeconds
#     Description: Minimum gap between direct/responsive chatter messages in the same
#                  party. (Seconds, 0-300.)
#     Default:     4
AzerothVoices.PartyGate.ResponsiveMinGapSeconds = 4

# AzerothVoices.PartyGate.UrgentMinGapSeconds
#     Description: Minimum gap between urgent callout messages in the same party.
#                  (Seconds, 0-300.)
#     Default:     0
AzerothVoices.PartyGate.UrgentMinGapSeconds = 0

# AzerothVoices.PartyGate.PreLLMDeferThresholdSeconds
#     Description: Threshold in seconds beyond which pre-LLM filler requests are
#                  deferred or dropped. (Seconds, 0-60.)
#     Default:     4
AzerothVoices.PartyGate.PreLLMDeferThresholdSeconds = 4

# AzerothVoices.PartyGate.MaxFillerDelaySeconds
#     Description: Maximum post-generation delay cap for filler chatter. (Seconds,
#                  5-300.)
#     Default:     45
AzerothVoices.PartyGate.MaxFillerDelaySeconds = 45

# AzerothVoices.PartyGate.DebugLog
#     Description: Enables debug logging for PartyGate policy decisions and pacing
#                  reservations.
#     Default:     0
AzerothVoices.PartyGate.DebugLog = 0

# --------------------------------------------
# 17. LIGHTWEIGHT LIVE ENVIRONMENT CONTEXT
# --------------------------------------------

# AzerothVoices.Environment.Enable
#     Description: Adds map/zone/area/dungeon/combat/group/guild and bounded context.
#     Default:     1
AzerothVoices.Environment.Enable = 1

# AzerothVoices.Environment.Distance
#     Description: Radius for bounded nearby alive creature names, including friendly,
#                  neutral, or hostile creatures. (Decimal yards, clamped 1-100.)
#     Default:     25
AzerothVoices.Environment.Distance = 25

# AzerothVoices.Environment.MaximumCreatures
#     Description: Maximum nearby creature names after bounded collection; 0 disables
#                  them. (Entries, clamped 0-50.)
#     Default:     5
AzerothVoices.Environment.MaximumCreatures = 5

# AzerothVoices.Environment.MaximumItems
#     Description: Combined equipment/backpack item-name cap; 0 disables item names.
#                  (Entries, clamped 0-50.)
#     Default:     8
AzerothVoices.Environment.MaximumItems = 8

# AzerothVoices.Environment.IncludeEquipment
#     Description: Includes bounded PlayerBot equipment names in context.
#     Default:     1
AzerothVoices.Environment.IncludeEquipment = 1

# AzerothVoices.Environment.IncludeBackpack
#     Description: Includes bounded backpack names; off keeps prompts lightweight.
#     Default:     0
AzerothVoices.Environment.IncludeBackpack = 0

# --------------------------------------------
# 18. EVENT CHATTER
# --------------------------------------------
#
# Automatic vMaNGOS hooks: creature/player kill, death, loot, quest complete, spell learned,
# duel request/start/win, level-up, login, guild join, and guild leave.
# Automatic & core hooks: pet_defeated, used_object, guild promotion/demotion,
# dungeon_completed, and game_event_started/stopped. Hooked natively into engine scripts
# and commands, and also triggerable externally or via .av event.
# Guild join/leave/login/promotion/demotion and guilded level-up events use Guild and require an
# online real guild listener. Other events prioritize Party for PlayerBots in the subject's party
# subgroup, then use Say for remaining nearby PlayerBot/NPC responders. Say actors require a real
# human within SayDistance; Party actors require a real human in the same party subgroup.
# --------------------------------------------

# AzerothVoices.Events.Enable
#     Description: Master switch for automatic and adapter event reactions.
#     Default:     1
AzerothVoices.Events.Enable = 1

# AzerothVoices.Events.ResponderChance
#     Description: Second-stage chance that other actors react after the selected
#                  scope's real-audience check passes. (Percentage.)
#     Default:     15
AzerothVoices.Events.ResponderChance = 15

# AzerothVoices.Events.SelfCommentChance
#     Description: Chance an AI PlayerBot comments on its own event through Guild,
#                  preferred Party, or fallback Say after the selected scope's audience
#                  check passes. (Percentage.)
#     Default:     5
AzerothVoices.Events.SelfCommentChance = 5

# AzerothVoices.Events.MaximumResponders
#     Description: Maximum other responders to one event. (Actors, minimum 1.)
#     Default:     2
AzerothVoices.Events.MaximumResponders = 2

# AzerothVoices.Events.CooldownSeconds
#     Description: Per-subject/per-event repeat cooldown. (Seconds, minimum 0.)
#     Default:     300
AzerothVoices.Events.CooldownSeconds = 300

# AzerothVoices.Events.Chance.CreatureDefeated
#     Description: Initial chance for an automatic creature-kill event. (Percentage.)
#     Default:     8
AzerothVoices.Events.Chance.CreatureDefeated = 8

# AzerothVoices.Events.Chance.PlayerDefeated
#     Description: Initial chance for an automatic PvP-kill event. (Percentage.)
#     Default:     40
AzerothVoices.Events.Chance.PlayerDefeated = 40

# AzerothVoices.Events.Chance.Died
#     Description: Initial chance for automatic player-death event. (Percentage.)
#     Default:     25
AzerothVoices.Events.Chance.Died = 25

# AzerothVoices.Events.Chance.ItemLooted
#     Description: Initial chance for automatic non-rare loot chatter. (Percentage.)
#     Default:     8
AzerothVoices.Events.Chance.ItemLooted = 8

# AzerothVoices.Events.Chance.QuestCompleted
#     Description: Initial chance for automatic quest-completion chatter. (Percentage.)
#     Default:     25
AzerothVoices.Events.Chance.QuestCompleted = 25

# AzerothVoices.Events.Chance.SpellLearned
#     Description: Initial chance for automatic spell-learning chatter. (Percentage.)
#     Default:     15
AzerothVoices.Events.Chance.SpellLearned = 15

# AzerothVoices.Events.Chance.DuelRequested
#     Description: Initial chance for automatic duel-request chatter. (Percentage.)
#     Default:     25
AzerothVoices.Events.Chance.DuelRequested = 25

# AzerothVoices.Events.Chance.DuelStarted
#     Description: Initial chance for automatic duel-start chatter. (Percentage.)
#     Default:     20
AzerothVoices.Events.Chance.DuelStarted = 20

# AzerothVoices.Events.Chance.DuelWon
#     Description: Initial chance for automatic duel-victory chatter. (Percentage.)
#     Default:     35
AzerothVoices.Events.Chance.DuelWon = 35

# AzerothVoices.Events.Chance.LevelUp
#     Description: Initial chance for level-up chatter; a guilded subject requires a
#                  real guild listener and uses Guild, otherwise Party is preferred
#                  before Say. (Percentage.)
#     Default:     50
AzerothVoices.Events.Chance.LevelUp = 50

# AzerothVoices.Events.Chance.GuildJoin
#     Description: Initial chance for automatic Guild chatter on guild join; requires an
#                  online real member in that guild. (Percentage.)
#     Default:     60
AzerothVoices.Events.Chance.GuildJoin = 60

# AzerothVoices.Events.Chance.GuildLeave
#     Description: Initial chance for Guild chatter on guild leave; the old guild id is
#                  retained and an online real member must remain in that guild.
#                  (Percentage.)
#     Default:     40
AzerothVoices.Events.Chance.GuildLeave = 40

# AzerothVoices.Events.Chance.GuildLogin
#     Description: Initial chance for automatic Guild chatter on guild login; requires
#                  an online real member in that guild. (Percentage.)
#     Default:     10
AzerothVoices.Events.Chance.GuildLogin = 10

# AzerothVoices.Events.Chance.GuildPromotion
#     Description: Initial chance for adapter-supplied Guild chatter on promotion;
#                  requires an online real member in that guild. (Percentage.)
#     Default:     50
AzerothVoices.Events.Chance.GuildPromotion = 50

# AzerothVoices.Events.Chance.GuildDemotion
#     Description: Initial chance for adapter-supplied Guild chatter on demotion;
#                  requires an online real member in that guild. (Percentage.)
#     Default:     30
AzerothVoices.Events.Chance.GuildDemotion = 30

# AzerothVoices.Events.Chance.PetDefeated
#     Description: Initial chance for adapter-supplied pet-defeat chatter. (Percentage.)
#     Default:     20
AzerothVoices.Events.Chance.PetDefeated = 20

# AzerothVoices.Events.Chance.UsedObject
#     Description: Initial chance for adapter-supplied object-use chatter. (Percentage.)
#     Default:     10
AzerothVoices.Events.Chance.UsedObject = 10

# AzerothVoices.Events.Chance.RareItem
#     Description: Initial chance for automatic rare-loot chatter; Party is preferred
#                  before Say. (Percentage.)
#     Default:     45
AzerothVoices.Events.Chance.RareItem = 45

# AzerothVoices.Events.Chance.EpicItem
#     Description: Initial chance for automatic epic-loot chatter; Party is preferred
#                  before Say. (Percentage.)
#     Default:     75
AzerothVoices.Events.Chance.EpicItem = 75

# AzerothVoices.Events.Chance.DungeonCompleted
#     Description: Initial chance for adapter-supplied dungeon completion. (Percentage.)
#     Default:     70
AzerothVoices.Events.Chance.DungeonCompleted = 70

# AzerothVoices.Events.Chance.GameEventStarted
#     Description: Initial chance for adapter game-event start chatter; Party is
#                  preferred before Say. (Percentage.)
#     Default:     50
AzerothVoices.Events.Chance.GameEventStarted = 50

# AzerothVoices.Events.Chance.GameEventStopped
#     Description: Initial chance for adapter game-event stop chatter; Party is
#                  preferred before Say. (Percentage.)
#     Default:     30
AzerothVoices.Events.Chance.GameEventStopped = 30

# --------------------------------------------
# 19. REPLY LENGTH AND PLAYERBOTS-COMPATIBLE TYPING DELAY
# --------------------------------------------

# AzerothVoices.Typing.Enable
#     Description: Delays delivery so generated chat appears naturally typed.
#     Default:     1
AzerothVoices.Typing.Enable = 1

# AzerothVoices.Typing.BaseDelayMilliseconds
#     Description: Fixed delay added to each line. (Milliseconds, minimum 0.)
#     Default:     0
AzerothVoices.Typing.BaseDelayMilliseconds = 0

# AzerothVoices.Typing.MinimumDelayPerCharacterMilliseconds
#     Description: Minimum natural typing delay; one speed is randomly selected between
#                  the minimum and maximum for each delivered reply line. (Ms/character,
#                  minimum 0.)
#     Default:     100
#
#     Realistic typing speeds:
#     - 400ms per char = 2.5 chars/sec (slow/casual)
#     - 250ms per char = 4 chars/sec (average human)
#     - 150ms per char = 6.7 chars/sec (proficient)
#     - 100ms per char = 10 chars/sec (professional)
AzerothVoices.Typing.MinimumDelayPerCharacterMilliseconds = 100

# AzerothVoices.Typing.MaximumDelayPerCharacterMilliseconds
#     Description: Maximum natural typing delay; values below the minimum are swapped
#                  safely. (Ms/character, minimum 0.)
#     Default:     200
AzerothVoices.Typing.MaximumDelayPerCharacterMilliseconds = 200

# AzerothVoices.Typing.SubtractGenerationTime
#     Description: Legacy compatibility: if both range keys above are absent,
#                  AzerothVoices.Typing.DelayPerCharacterMilliseconds is still accepted
#                  as one fixed per-character delay. Subtracts provider generation time
#                  from the simulated typing delay, preserving the restored PlayerBots-
#                  style delivery timing.
#     Default:     1
AzerothVoices.Typing.SubtractGenerationTime = 1

# AzerothVoices.Reply.MaximumCharacters
#     Description: Maximum character budget per delivered reply line. Messages are
#                  cleanly split on sentence and clause boundaries so each message
#                  fits within this character limit without sentence starvation.
#                  (Characters, minimum 1.)
#     Default:     120
AzerothVoices.Reply.MaximumCharacters = 120

# AzerothVoices.Reply.MaximumLines
#     Description: Maximum delivered lines/parts per request. Limits the number of
#                  separate chat messages a bot can send per response turn. (Lines,
#                  minimum 1.)
#     Default:     2
AzerothVoices.Reply.MaximumLines = 2

# AzerothVoices.Reply.SentenceAwareSplitting
#     Description: Enables structured, sentence-aware line breaking for delivered
#                  dialogue. When enabled, replies are cleanly split on natural sentence
#                  boundaries (.!?) and clause punctuation (,;-) instead of greedily
#                  packing characters and breaking in the middle of sentences across
#                  messages.
#     Default:     1
AzerothVoices.Reply.SentenceAwareSplitting = 1

# --------------------------------------------
# 20. BOUNDED CONVERSATION AND SURROUNDING-CHAT HISTORY
# --------------------------------------------

# AzerothVoices.History.StorageMode
#     Description: 0 disables conversation history, 1 keeps bounded history only in RAM
#                  until restart, and 2 persists it in the character database with a
#                  bounded lazy-loaded RAM cache (falling back to RAM if the module
#                  tables are unavailable). (Mode 0/1/2.)
#     Default:     2
AzerothVoices.History.StorageMode = 2


# --- SQL MODE SETTINGS (StorageMode = 2) ---

# AzerothVoices.History.DatabaseMaximumTurns
#     Description: Used only when StorageMode = 2 (SQL); turns, default 20. Caps
#                  persistent rows and lazy-loaded hot-cache turns per conversation.
#     Default:     20
AzerothVoices.History.DatabaseMaximumTurns = 20

# AzerothVoices.History.DatabaseTTLMinutes
#     Description: Used only when StorageMode = 2 (SQL); minutes, default 10080 (7
#                  days). Older persistent conversation turns are not loaded and are
#                  deleted by cleanup.
#     Default:     10080 (7 days)
AzerothVoices.History.DatabaseTTLMinutes = 10080

# AzerothVoices.History.DatabaseFlushSeconds
#     Description: Used only when a StorageMode = 2 (SQL) feature has queued rows;
#                  seconds, default 5. Sets the maximum delay before batched
#                  history/snapshot writes flush.
#     Default:     5
AzerothVoices.History.DatabaseFlushSeconds = 5

# AzerothVoices.History.DatabaseFlushBatchSize
#     Description: Used only when a StorageMode = 2 (SQL) feature has queued rows; rows,
#                  default 20. Flushes the shared history/snapshot transaction when this
#                  many rows wait.
#     Default:     20
AzerothVoices.History.DatabaseFlushBatchSize = 20


# --- RAM MODE SETTINGS (StorageMode = 1) ---

# AzerothVoices.History.RamMaximumTurns
#     Description: Used only when StorageMode = 1 (RAM); turns, default 6. Caps retained
#                  turns per conversation until worldserver restarts.
#     Default:     6
AzerothVoices.History.RamMaximumTurns = 6

# AzerothVoices.History.TTLMinutes
#     Description: Prompt-age limit for conversation turns in RAM or the SQL hot cache.
#                  (Minutes, minimum 1.)
#     Default:     30
AzerothVoices.History.TTLMinutes = 30

# AzerothVoices.History.MaximumCharacters
#     Description: Hard rendered conversation-history cap per provider request.
#                  (Characters, minimum 128.)
#     Default:     2500
AzerothVoices.History.MaximumCharacters = 2500

# AzerothVoices.History.MaximumConversations
#     Description: Hard bound on in-memory conversation buckets in StorageMode 1 or 2.
#                  (Keys, minimum 1.)
#     Default:     2048
AzerothVoices.History.MaximumConversations = 2048

# AzerothVoices.History.HeaderTemplate
#     Description: Introduces previous conversation context. (Text template.)
AzerothVoices.History.HeaderTemplate = Recent conversation with <sender name>, use it only as context:

# AzerothVoices.History.LineTemplate
#     Description: Renders each stored exchange. (Text template with \n escapes.)
AzerothVoices.History.LineTemplate = <sender name>: <sender message>\n<bot name>: <bot reply>\n

# AzerothVoices.History.FooterTemplate
#     Description: Separates history from the new incoming message. (Text template.)
AzerothVoices.History.FooterTemplate = New message from <sender name>: <initial message>

# AzerothVoices.SurroundingChat.Enable
#     Description: Adds recent lines only from the same whisper, group, guild, channel,
#                  or local map-area scope so references such as "him" or "that" retain
#                  context.
#     Default:     1
AzerothVoices.SurroundingChat.Enable = 1

# AzerothVoices.SurroundingChat.MaximumLines
#     Description: Hard per-scope recent-line cap. (Lines, minimum 0.)
#     Default:     8
AzerothVoices.SurroundingChat.MaximumLines = 8

# AzerothVoices.SurroundingChat.TTLMinutes
#     Description: Discards stale surrounding lines. (Minutes, minimum 1.)
#     Default:     5
AzerothVoices.SurroundingChat.TTLMinutes = 5

# AzerothVoices.SurroundingChat.MaximumCharacters
#     Description: Rendered surrounding-context cap. (Characters, minimum 128.)
#     Default:     1200
AzerothVoices.SurroundingChat.MaximumCharacters = 1200

# AzerothVoices.SurroundingChat.MaximumScopes
#     Description: Hard bound on RAM scope buckets. (Scopes, minimum 1.)
#     Default:     512
AzerothVoices.SurroundingChat.MaximumScopes = 512

# --------------------------------------------
# 21. SNAPSHOT SYSTEM
# --------------------------------------------

# AzerothVoices.Snapshot.Enable
#     Description: When enabled, adds a richer PlayerBot-only world-thread block with
#                  combat, group, spells, quests, visible objects, and nearby players;
#                  disabling omits it, while enabling increases prompt tokens and may
#                  increase provider response time.
#     Default:     0
AzerothVoices.Snapshot.Enable = 0

# AzerothVoices.Snapshot.IncludeCombat
#     Description: Adds current health, active power resource, combat state, victim
#                  name/level/health, and whether the bot is fighting.
#     Default:     1
AzerothVoices.Snapshot.IncludeCombat = 1

# AzerothVoices.Snapshot.IncludeGroup
#     Description: Adds bounded same-map group members with class, race, health,
#                  distance, and current fighting state.
#     Default:     1
AzerothVoices.Snapshot.IncludeGroup = 1

# AzerothVoices.Snapshot.IncludeSpells
#     Description: Adds bounded active known spells after removing passive/internal
#                  entries and keeping the highest useful rank for each spell name.
#     Default:     1
AzerothVoices.Snapshot.IncludeSpells = 1

# AzerothVoices.Snapshot.IncludeQuests
#     Description: Adds bounded quest-log titles and whether each active quest is in
#                  progress, complete, or failed.
#     Default:     1
AzerothVoices.Snapshot.IncludeQuests = 1

# AzerothVoices.Snapshot.IncludeLineOfSight
#     Description: Adds bounded nearby creatures and spawned game objects that pass the
#                  bot's live line-of-sight check.
#     Default:     1
AzerothVoices.Snapshot.IncludeLineOfSight = 1

# AzerothVoices.Snapshot.IncludeNearbyPlayers
#     Description: Adds bounded non-GM players and PlayerBots within range and line of
#                  sight with level, race, class, faction, distance, and actor type.
#     Default:     1
AzerothVoices.Snapshot.IncludeNearbyPlayers = 1

# AzerothVoices.Snapshot.Distance
#     Description: Shared bounded search radius for snapshot creature, game-object, and
#                  nearby-player collection; group distance is reported for same-map
#                  members. (Decimal yards, clamped 1-100.)
#     Default:     40
AzerothVoices.Snapshot.Distance = 40

# AzerothVoices.Snapshot.MaximumGroupMembers
#     Description: Maximum other group members rendered in the current snapshot; 0 omits
#                  the group-member list. (Entries, clamped 0-40.)
#     Default:     5
AzerothVoices.Snapshot.MaximumGroupMembers = 5

# AzerothVoices.Snapshot.MaximumSpells
#     Description: Maximum deduplicated highest-rank usable spell names rendered in the
#                  current snapshot; 0 omits spells. (Entries, clamped 0-100.)
#     Default:     20
AzerothVoices.Snapshot.MaximumSpells = 20

# AzerothVoices.Snapshot.MaximumQuests
#     Description: Maximum occupied quest-log entries rendered in the current snapshot;
#                  0 omits quests. (Entries, clamped 0-20.)
#     Default:     10
AzerothVoices.Snapshot.MaximumQuests = 10

# AzerothVoices.Snapshot.MaximumCreatures
#     Description: Maximum line-of-sight creatures rendered after bounded collection and
#                  nearest-first sorting; 0 omits creatures. (Entries, clamped 0-50.)
#     Default:     10
AzerothVoices.Snapshot.MaximumCreatures = 10

# AzerothVoices.Snapshot.MaximumGameObjects
#     Description: Maximum spawned line-of-sight game objects rendered after bounded
#                  collection and nearest-first sorting; 0 omits game objects. (Entries,
#                  clamped 0-50.)
#     Default:     8
AzerothVoices.Snapshot.MaximumGameObjects = 8

# AzerothVoices.Snapshot.MaximumPlayers
#     Description: Maximum non-GM nearby players rendered after bounded collection and
#                  nearest-first sorting; 0 omits players. (Entries, clamped 0-50.)
#     Default:     8
AzerothVoices.Snapshot.MaximumPlayers = 8

# AzerothVoices.Snapshot.MaximumCharacters
#     Description: Hard cap on the complete current detailed snapshot before it enters
#                  the request context budget. (Characters, clamped 256-16000.)
#     Default:     3500
AzerothVoices.Snapshot.MaximumCharacters = 3500

# AzerothVoices.Snapshot.PromptTemplate
#     Description: Replaces {combat}, {group}, {spells}, {quests}, {line_of_sight}, and
#                  {nearby_players}; disabled or empty sections insert no text. (Text
#                  template with literal \n line breaks.)
AzerothVoices.Snapshot.PromptTemplate = "CURRENT PLAYERBOT SNAPSHOT:\n{combat}\n{group}\n{spells}\n{quests}\n{line_of_sight}\n{nearby_players}"

# AzerothVoices.Snapshot.StorageMode
#     Description: Controls only older delivered snapshots: 0 stores none while the
#                  current snapshot still works, 1 stores bounded RAM until restart, and
#                  2 persists SQL plus a lazy RAM cache (falling back to bounded RAM if
#                  tables are unavailable). (Mode 0/1/2.)
#     Default:     0
AzerothVoices.Snapshot.StorageMode = 0


# --- SQL MODE SETTINGS (StorageMode = 2) ---

# AzerothVoices.Snapshot.DatabaseMaximumSnapshots
#     Description: Used only when StorageMode = 2 (SQL); snapshots, default 10. Caps
#                  persistent rows and lazy-loaded hot-cache snapshots per PlayerBot.
#     Default:     10
AzerothVoices.Snapshot.DatabaseMaximumSnapshots = 10

# AzerothVoices.Snapshot.DatabaseTTLMinutes
#     Description: Used only when StorageMode = 2 (SQL); minutes, default 10080 (7
#                  days). Older persistent snapshots are not loaded and are deleted by
#                  cleanup.
#     Default:     10080 (7 days)
AzerothVoices.Snapshot.DatabaseTTLMinutes = 10080


# --- RAM MODE SETTINGS (StorageMode = 1) ---

# AzerothVoices.Snapshot.RamMaximumSnapshots
#     Description: Used only when StorageMode = 1 (RAM); snapshots, default 3. Caps
#                  retained snapshots per PlayerBot until worldserver restarts.
#     Default:     3
AzerothVoices.Snapshot.RamMaximumSnapshots = 3

# AzerothVoices.Snapshot.HistoryTTLMinutes
#     Description: Prompt-age limit for older snapshots in RAM or the SQL hot cache; the
#                  current live snapshot is never aged out. (Minutes, minimum 1.)
#     Default:     30
AzerothVoices.Snapshot.HistoryTTLMinutes = 30

# AzerothVoices.Snapshot.HistoryMaximumCharacters
#     Description: Hard combined prompt cap for older snapshots, separate from the
#                  richer current-snapshot cap. (Characters, minimum 128.)
#     Default:     1600
AzerothVoices.Snapshot.HistoryMaximumCharacters = 1600

# AzerothVoices.Snapshot.HistoryMaximumActors
#     Description: Hard bound on in-memory PlayerBot snapshot-history buckets in
#                  StorageMode 1 or 2. (Actors, minimum 1.)
#     Default:     2048
AzerothVoices.Snapshot.HistoryMaximumActors = 2048

# --------------------------------------------
# 22. STRUCTURED LOCAL RAG (OPTIONAL, NO EMBEDDINGS OR EXTRA PROVIDER CALL)
# --------------------------------------------

# AzerothVoices.RAG.Enable
#     Description: Loads cached local JSON lore and retrieves by keywords.
#     Default:     0
AzerothVoices.RAG.Enable = 0

# AzerothVoices.RAG.Directory
#     Description: Loads every .json file here and also checks the installed and source-
#                  tree module data paths so one value works in both deployments.
#                  (Directory path.)
AzerothVoices.RAG.Directory = modules/mod-azeroth-voices/data/rag/

# AzerothVoices.RAG.MaximumItems
#     Description: Maximum RAG excerpts per provider request. (Entries, minimum 1.)
#     Default:     3
AzerothVoices.RAG.MaximumItems = 3

# AzerothVoices.RAG.SimilarityThreshold
#     Description: Minimum local weighted similarity required to include an entry; lower
#                  values increase coverage and noise, higher values increase precision
#                  and may miss useful lore, with 0.2-0.4 recommended. (Decimal
#                  0.0-1.0.)
#     Default:     0.3
AzerothVoices.RAG.SimilarityThreshold = 0.3

# AzerothVoices.RAG.MaximumCharacters
#     Description: Total structured RAG prompt cap. (Characters, minimum 128.)
#     Default:     1200
AzerothVoices.RAG.MaximumCharacters = 1200

# AzerothVoices.RAG.ReloadOnRestart
#     Description: Reloads JSON when the module restarts via `.av restart`.
#     Default:     1
AzerothVoices.RAG.ReloadOnRestart = 1

# AzerothVoices.RAG.PromptTemplate
#     Description: The required {rag_info} placeholder is replaced with the selected
#                  local RAG excerpts before the provider request. (Text template with
#                  literal \n line breaks.)
AzerothVoices.RAG.PromptTemplate = "RELEVANT INFORMATION:\n{rag_info}\nUse this information to provide accurate and detailed responses when applicable."

# --------------------------------------------
# 23. AZEROTH VOICES COMPANION ADDON AND CHATTER COMPATIBILITY
# --------------------------------------------

# AzerothVoices.Addon.Enable
#     Description: Enables the `.avaddon` and legacy `.llmc` command channels along with
#                  `AZEROTH_VOICES` addon message and legacy `CHATTER_ADDON` system
#                  responses used by the bundled AzerothVoices client addon and stock
#                  Chatter clients. No GM security is required: a player only ever sees
#                  and edits bots in their own contact roster. Requires
#                  azeroth_voices_addon_contacts; when that table is missing the roster
#                  degrades to empty and every other subsystem keeps working.
#     Default:     1
AzerothVoices.Addon.Enable = 1

# AzerothVoices.Addon.MaximumRosterEntries
#     Description: Hard bound on the roster returned to one player. (Entries, minimum
#                  1.)
#     Default:     200
AzerothVoices.Addon.MaximumRosterEntries = 200
