AzerothVoices.GroupChatter.BossPullCooldownSeconds = 300

# AzerothVoices.GroupChatter.BossKillChance
#     Description: Chance the group reacts to a classified boss kill. (Percentage.)
#     Default:     80
AzerothVoices.GroupChatter.BossKillChance = 80

# AzerothVoices.GroupChatter.BossKillCooldownSeconds
#     Description: Cooldown after a boss-kill line. (Seconds, 0-86400.)
#     Default:     300
AzerothVoices.GroupChatter.BossKillCooldownSeconds = 300

# AzerothVoices.GroupChatter.WipeChance
