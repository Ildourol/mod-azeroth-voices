#     Default:     15
AzerothVoices.BossDialogue.DirectedReplyCooldownSeconds = 15

# AzerothVoices.BossDialogue.MinimumWords
#     Description: Lower word bound for an automatically generated boss line. (Words,
#                  1-100.)
#     Default:     5
AzerothVoices.BossDialogue.MinimumWords = 5

# AzerothVoices.BossDialogue.MaximumWords
#     Description: Upper word bound; a longer line is cut back to a word boundary and
#                  then rejected if it still exceeds the bound. Raised to MinimumWords
#                  when set lower. (Words, 1-200.)
#     Default:     22
AzerothVoices.BossDialogue.MaximumWords = 22

# AzerothVoices.BossDialogue.MaximumCharacters
#     Description: Hard character cap for one boss yell. (Characters, 20-1000.)
#     Default:     140
AzerothVoices.BossDialogue.MaximumCharacters = 140

# AzerothVoices.BossDialogue.AllowEntries
#     Description: Extra creature entries treated as bosses; empty means registry and
#                  fallbacks only. (Comma-separated creature entries.)
#     Default:     empty
AzerothVoices.BossDialogue.AllowEntries = 

# AzerothVoices.BossDialogue.DenyEntries
#     Description: Creature entries never treated as bosses; the denylist wins over
#                  registry, allow-list, and both fallbacks. (Comma-separated creature
#                  entries.)
#     Default:     empty
AzerothVoices.BossDialogue.DenyEntries = 

# --------------------------------------------
# 11. PARTY AND RAID CHATTER
# --------------------------------------------
#
# Group reactions run on top of the existing reply system: they need a real
# player in the same party subgroup (or raid), obey the normal audience,
# cooldown, queue and rate limits, and are exempt from DisableRepliesInCombat
# because in-combat callouts are the point. Every trigger ships enabled with the
# conservative defaults below; raise only the ones you want.
# --------------------------------------------

# AzerothVoices.GroupChatter.Enable
#     Description: Enables party chatter: idle, dungeon entry, zone change, kills, boss
#                  moments, wipes, deaths, corpse runs, resurrects, loot, quests, spell
#                  casts, low health/mana, nearby objects, bot questions and player-
#                  message follow-ups.
#     Default:     1
AzerothVoices.GroupChatter.Enable = 1

# AzerothVoices.GroupChatter.ScanSeconds
#     Description: Delay between group scans that evaluate the periodic triggers.
#                  (Seconds, 5-3600.)
#     Default:     300
AzerothVoices.GroupChatter.ScanSeconds = 300

# AzerothVoices.GroupChatter.IdleChance
#     Description: Chance a scan produces an ordinary casual group remark. (Percentage.)
#     Default:     2
AzerothVoices.GroupChatter.IdleChance = 2

# AzerothVoices.GroupChatter.IdleCooldownSeconds
#     Description: Cooldown after an idle remark. (Seconds, 0-86400.)
#     Default:     600
AzerothVoices.GroupChatter.IdleCooldownSeconds = 600

# AzerothVoices.GroupChatter.DungeonEntryChance
