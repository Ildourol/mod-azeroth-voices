[worldserver]

###################################################################################################
# mod-azeroth-voices configuration
# Provider-neutral LLM chat for TortoiseWoW/vMaNGOS (Turtle WoW 1.18.1 / 1.12.1)
###################################################################################################

#
# This is a TortoiseWoW/vMaNGOS worldserver module configuration.
# Legacy AiPlayerbot.LLM* names are retained where their meaning is compatible.
# The module does not read etc/aiplayerbot.conf automatically: copy wanted compatible values here.
# Percentages use 0 (never) through 100 (always) and are clamped to that range.
#

# --------------------------------------------
# 1. MODULE OWNERSHIP AND DIAGNOSTICS
# --------------------------------------------

# AzerothVoices.Enable
#     Description: Master switch for every module feature and HTTP request.
#     Default:     1
AzerothVoices.Enable = 1

# AzerothVoices.Debug
#     Description: Enables lightweight Azeroth Voices activity messages for
#                  administrators; 0 = disabled, 1 = enabled.
#     Default:     0
AzerothVoices.Debug = 0

# AzerothVoices.Console.GeneratedMessages
#     Description: Logs each cleaned reply with request ID, actor, actor kind, scope,
#                  trigger, speaker, HTTP status, generation time, and text; this may
#                  expose private chat in server logs.
#     Default:     0
AzerothVoices.Console.GeneratedMessages = 0

# AzerothVoices.Console.ApiCallStats
#     Description: Logs HTTP-attempt, success, failure, generated-message, and
#                  preflight-rejection totals every configured interval; each retry
#                  counts as another API call. It never repeats generated text.
#     Default:     0
AzerothVoices.Console.ApiCallStats = 0

# AzerothVoices.Console.ApiCallStatsIntervalSeconds
#     Description: Length of each terminal reporting window. (Seconds, minimum 5.)
#     Default:     60
AzerothVoices.Console.ApiCallStatsIntervalSeconds = 60

# --------------------------------------------
# 2. PROVIDER AND HTTPS
# --------------------------------------------

# AzerothVoices.ProviderMode
#     Description: ChatCompletions supports OpenAI, Gemini's OpenAI-compatible endpoint,
#                  OpenRouter, and compatible gateways; Responses uses OpenAI's
#                  /v1/responses request shape. (Enum ChatCompletions/Responses.)
#     Default:     ChatCompletions
AzerothVoices.ProviderMode = ChatCompletions

# AiPlayerbot.LLMApiEndpoint
#     Description: Full provider endpoint. Remote plain HTTP is rejected. (URL.)
#     Default:     OpenAI chat/completions
AiPlayerbot.LLMApiEndpoint = https://api.openai.com/v1/chat/completions

# AiPlayerbot.LLMApiKey
#     Description: Supplies the Bearer API token. (Secret or env:VARIABLE.)
#     Default:     env:OPENAI_API_KEY
AiPlayerbot.LLMApiKey = env:OPENAI_API_KEY

# AzerothVoices.Model
#     Description: Exact model identifier accepted by the selected endpoint. (String.)
#     Default:     gpt-4o-mini
AzerothVoices.Model = gpt-4o-mini

# AiPlayerbot.LLMApiJson
#     Description: Empty lets the module generate provider-safe JSON; a custom legacy
#                  template may use <pre prompt>, <context>, <prompt>, <model>, and
#                  documented chat placeholders. (JSON template.)
#     Default:     empty
AiPlayerbot.LLMApiJson = 

# AzerothVoices.ParserMode
#     Description: ProviderJson parses OpenAI chat/Responses, Gemini candidates, and
#                  Ollama JSON; LegacyRegex uses the regex settings below. (Enum
#                  ProviderJson/LegacyRegex.)
#     Default:     ProviderJson
AzerothVoices.ParserMode = ProviderJson

# AzerothVoices.CACertFile
#     Description: Empty uses system CAs; otherwise uses this custom CA bundle. (File
#                  path.)
#     Default:     empty
AzerothVoices.CACertFile = 

# AzerothVoices.AllowLocalHttp
#     Description: Allows plain HTTP only for local/loopback providers, never remote
#                  HTTP.
#     Default:     1
AzerothVoices.AllowLocalHttp = 1

# AzerothVoices.ConnectTimeoutSeconds
#     Description: TCP/TLS connection timeout. (Seconds, minimum 1.)
#     Default:     10
AzerothVoices.ConnectTimeoutSeconds = 10

# AiPlayerbot.LLMGenerationTimeout
#     Description: Provider read/write generation timeout. (Seconds, minimum 1.)
#     Default:     60
AiPlayerbot.LLMGenerationTimeout = 60

# AzerothVoices.MaxResponseBytes
#     Description: Rejects oversized HTTP responses. (Bytes, minimum 1024.)
#     Default:     65536
AzerothVoices.MaxResponseBytes = 65536

# AzerothVoices.MaxTokens
#     Description: Requested output limit in generated provider JSON. (Tokens, minimum
#                  1.)
#     Default:     100
#
#     IMPORTANT: this cap covers reasoning AND the reply. On a reasoning model
#     (gpt-oss, deepseek-r1, qwen3 thinking builds) the reasoning is emitted
#     first, so a low cap is spent before the reply starts and the bot returns
#     nothing. Those models reason even with think mode off -- 'think': false
#     is a request, not a guarantee. See AzerothVoices.Thinking.TokenReserve.
#
#     | MaxTokens  | Approx. Words | Use Case                         |
#     |:----------:|:-------------:|:---------------------------------|
#     |     20     |   ~13–15      | Very short/emote/chat            |
#     |     30     |     ~20       | Short reply                      |
#     |     40     |   ~27–30      | Standard WoW reply (recommended) |
#     |     50     |   ~35–38      | Slightly longer reply            |
#     |     75     |   ~50–60      | Long quest/lore text             |
#     |    100+    |   70–80+      | Multi-paragraph (not typical)    |
AzerothVoices.MaxTokens = 100

# AzerothVoices.Thinking.Mode
#     Description: Official-endpoint Thinking policy. Only api.openai.com and
#                  generativelanguage.googleapis.com receive Thinking fields; every
#                  proxy or other OpenAI-compatible provider stays a normal non-thinking
#                  provider. The former AzerothVoices.ReasoningEffort key is retired and
#                  ignored. Auto applies a control only for an officially recognised
#                  provider/model and an enabled AutoKind; On applies it for any
#                  recognised provider/model; Off omits the optional control and, for
#                  models whose reasoning cannot be disabled, sends the lowest
#                  documented level without pretending to disable reasoning. (Enum
#                  Auto/On/Off.)
#     Default:     Auto
AzerothVoices.Thinking.Mode = Auto

# AzerothVoices.Thinking.AutoDetect
#     Description: Recognises the provider and model capability from the endpoint and
#                  model name without probing the provider. With 0 only an explicit
#                  Thinking.Mode = On applies a control; the module never guesses for an
#                  unrecognised model. (Accepted 0/1.)
#     Default:     1
AzerothVoices.Thinking.AutoDetect = 1

# AzerothVoices.Thinking.Effort
#     Description: Requested reasoning level. Minimal collapses to Low on the Responses
#                  API and on Gemini and always-on models. (Enum
#                  Minimal/Low/Medium/High.)
#     Default:     Low
AzerothVoices.Thinking.Effort = Low

# AzerothVoices.Thinking.TokenReserve
#     Description: Added to the active output-token field only when a Thinking control
#                  is actually applied, so a reasoning budget never truncates the
#                  visible reply. (Tokens, 0-100000.)
#     Default:     1024
#
#     Extra token headroom added when reasoning tokens are expected.
#     Added to the active output-token field only when a Thinking control
#     is actually applied, so a reasoning budget never truncates the visible reply.
#     Has no effect when MaxTokens is not constrained or model is non-reasoning.
AzerothVoices.Thinking.TokenReserve = 1024

# AzerothVoices.Thinking.AutoKinds
#     Description: Request purposes that Auto mode may control. PersonalityGeneration
#                  covers identity generation; DirectChat covers PlayerBot direct
#                  replies, TargetedNpc the named/selected/scene NPC triggers, EventChat
#                  event reactions, AmbientChat random chatter, FollowupChat generated
#                  follow-ups. Overheard chat, GM tests, boss, proximity, group and
#                  guild triggers stay non-reasoning in Auto. (Comma-separated kinds,
#                  case-insensitive, duplicates ignored.)
#     Default:     PersonalityGeneration,EventChat
AzerothVoices.Thinking.AutoKinds = PersonalityGeneration,EventChat

# AzerothVoices.Temperature
#     Description: Sampling randomness; invalid values are clamped. (Decimal 0.0-2.0.)
#     Default:     0.8
AzerothVoices.Temperature = 0.8

# AzerothVoices.TopP
#     Description: Nucleus sampling; invalid values are clamped. (Decimal 0.0-1.0.)
#     Default:     0.95
AzerothVoices.TopP = 0.95

# --------------------------------------------
# 3. WORKER POOL, QUEUE, LIMITS, AND COOLDOWNS
# --------------------------------------------

# AzerothVoices.WorkerThreads
#     Description: Fixed background HTTP workers; core objects stay on world thread.
#                  (1-32.)
#     Default:     8
AzerothVoices.WorkerThreads = 8

# AiPlayerbot.LLMMaxSimultaniousGenerations
#     Description: Legacy misspelled fallback used only if WorkerThreads is absent.
#                  (1-32.)
#     Default:     8
AiPlayerbot.LLMMaxSimultaniousGenerations = 8

# AzerothVoices.QueueMaximum
#     Description: Hard pending-queue memory bound. (Requests, minimum 1.)
#     Default:     128
AzerothVoices.QueueMaximum = 128

# AzerothVoices.HighPriorityReserve
#     Description: Queue capacity reserved for direct/group replies. (0-QueueMaximum.)
#     Default:     32
AzerothVoices.HighPriorityReserve = 32

# AzerothVoices.GlobalRequestsPerMinute
#     Description: Global budget shared by all workers. (Requests/minute, minimum 1.)
#     Default:     60
AzerothVoices.GlobalRequestsPerMinute = 60

# AzerothVoices.RequestTTLSeconds
#     Description: Drops queued requests that are no longer timely. (Seconds, minimum
#                  1.)
#     Default:     90
AzerothVoices.RequestTTLSeconds = 90

# AzerothVoices.AmbientActorCooldownSeconds
#     Description: Longer per-actor random-chatter cooldown. (Seconds, minimum 0.)
#     Default:     300
AzerothVoices.AmbientActorCooldownSeconds = 300

# AzerothVoices.BotSpeakerCooldownSeconds
#     Description: Per-bot cooldown (seconds) for General channel speech. After a bot
#                  speaks in General, it cannot speak again until this cooldown expires.
#                  Spreads voices across different bots so the same one doesn't
#                  dominate. Does NOT affect party chat or event reactions. Default: 900
#                  (15 minutes)
#     Default:     900 (15 minutes)
AzerothVoices.BotSpeakerCooldownSeconds = 900

# AzerothVoices.RetryMaximum
#     Description: Retries transient connection, 429, and 5xx failures. (Retries,
#                  minimum 0.)
#     Default:     1
AzerothVoices.RetryMaximum = 1

# AzerothVoices.RetryBackoffMilliseconds
#     Description: Base increasing delay between retries. (Milliseconds, minimum 0.)
#     Default:     500
AzerothVoices.RetryBackoffMilliseconds = 500

# --------------------------------------------
# 4. SHARED PROMPTS AND PLAYERBOTS-COMPATIBLE PROMPT NAMES
# --------------------------------------------

# AzerothVoices.GlobalMode
#     Description: Selects PlayerBot conversation style for PlayerBot-to-real-player and
#                  PlayerBot-to-PlayerBot dialogue; Roleplay keeps them in-world, Normal
#                  makes them speak like believable real WoW players, and any
#                  interaction involving an NPC is forced to Roleplay by typed C++
#                  participant policy before provider JSON is sent. (Enum
#                  Roleplay/Normal.)
#     Default:     Normal
AzerothVoices.GlobalMode = Normal

# AzerothVoices.GlobalPrompt.Roleplay
#     Description: System prompt selected by GlobalMode=Roleplay; it keeps PlayerBots
#                  and NPCs inside Azeroth and forbids real-world player/meta framing.
#                  Structured and compact rules enforce authentic, in-world immersion
#                  without meta concepts, real life, or action narration. (Text.)
AzerothVoices.GlobalPrompt.Roleplay = You are a character living in the fantasy world of Azeroth. Speak naturally and in-character. Rules: 1. IMMERSIVE RP: Speak strictly in-world with lived experience. Never mention real life, computers, gaming, AI, or meta concepts. 2. NATURAL DIALOGUE: Keep speech concise, grounded, and believable; never narrate actions or stage directions. 3. IN-WORLD REALITY: Treat danger, zones, quests, and factions as authentic everyday life. 4. FORMAT: Return only spoken words. No names, quotes, or dialogue tags.

# AzerothVoices.GlobalPrompt.Normal
#     Description: System prompt selected by GlobalMode=Normal for PlayerBot-to-real-
#                  player and PlayerBot-to-PlayerBot dialogue; NPC-involved dialogue is
#                  switched to GlobalPrompt.Roleplay by C++ before provider
#                  serialization, so customizing this prompt cannot opt NPCs into Normal
#                  mode. Structured and compact rules enforce authentic, casual human
#                  player chat without poetic, fantasy, or roleplaying dialogue. (Text.)
AzerothVoices.GlobalPrompt.Normal = You are a real human playing an online game. Rules: 1. NO ROLEPLAY: No fantasy talk, in-character acting, or abstract themes. 2. NO POETICS: No poetic, flowery, or theatrical phrasing. 3. CASUAL GAMER: Short, natural, grounded chat like an ordinary person playing; do not over-mention the game. 4. FORMAT: Return only the spoken text. No names or dialogue tags.

# AiPlayerbot.LLMPrePrompt
#     Description: Describes a PlayerBot before a normal response. (Text template.)
AiPlayerbot.LLMPrePrompt = You are <bot name>, a level <bot level> <bot race> <bot class> in <bot subzone>, <bot zone>. <bot personality block>

# AiPlayerbot.LLMPrompt
#     Description: Formats incoming chat for the provider using the actual incoming
#                  speaker name. (Text template.)
AiPlayerbot.LLMPrompt = <sender name>: <initial message>

# AiPlayerbot.LLMPostPrompt
#     Description: Optional response cue appended after incoming chat; empty by default
#                  because the system/pre-prompt already identifies the responding
#                  actor. (Text template.)
#     Default:     empty
AiPlayerbot.LLMPostPrompt = 

# AiPlayerbot.LLMRpgPrompt
#     Description: Shared prompt for a nearby NPC speaker. (Text template.)
AiPlayerbot.LLMRpgPrompt = You are <bot name>, an NPC in <bot subzone>, <bot zone>. Reply briefly in character.

# AiPlayerbot.LLMContextLength
#     Description: Caps the combined personality, live environment, current/older
#                  snapshots, histories, surrounding chat, and RAG context added to a
#                  request. (Characters, minimum 0.)
#     Default:     4096
AiPlayerbot.LLMContextLength = 4096

# AiPlayerbot.LLMGlobalContext
#     Description: 0 isolates history by speaker/scope; 1 shares actor-wide history.
#     Default:     0
AiPlayerbot.LLMGlobalContext = 0

# AiPlayerbot.LLMResponseStartPattern
#     Description: LegacyRegex-only response start matcher. (ECMAScript regex.)
AiPlayerbot.LLMResponseStartPattern = ("content":\s*")

# AiPlayerbot.LLMResponseEndPattern
#     Description: LegacyRegex-only response end matcher. (ECMAScript regex.)
AiPlayerbot.LLMResponseEndPattern = ("|\b(?!<sender name>\b)(\w+):)

# AiPlayerbot.LLMResponseDeletePattern
#     Description: LegacyRegex-only unwanted-fragment remover. (ECMAScript regex.)
AiPlayerbot.LLMResponseDeletePattern = (\\n|<sender name>:|\\[^ ]+)

# AiPlayerbot.LLMResponseSplitPattern
#     Description: Optional LegacyRegex multi-line split matcher. (ECMAScript regex.)
#     Default:     empty
AiPlayerbot.LLMResponseSplitPattern = 

# AiPlayerbot.LLMBlockedReplyChannels
#     Description: Blocks matching replies, ignoring case. (Comma-separated
#                  scope/channel names.)
#     Default:     empty
AiPlayerbot.LLMBlockedReplyChannels = 

# --------------------------------------------
# 5. PERSISTENT PLAYERBOT PERSONALITIES
# --------------------------------------------

# AzerothVoices.Personality.Enable
#     Description: Enables persistent PlayerBot personalities and backgrounds; accepted
#                  values 0/1; default 1; disabling preserves stored data and previous
#                  chat behavior.
#     Default:     1
AzerothVoices.Personality.Enable = 1

# AzerothVoices.Personality.BackgroundMode
#     Description: Selects background style; 0 = roleplay Azeroth character (guided by
#                  Personality.Prompt.Roleplay), 1 = fictional real-world WoW player persona
#                  (guided by Personality.Prompt.Normal) with a uniformly distributed adult
#                  age (19-58) randomized by C++; default 1.
#     Default:     1
AzerothVoices.Personality.BackgroundMode = 1

# AzerothVoices.Personality.GenerateBackground
#     Description: Generates and persists a background story for missing personalities;
#                  accepted values 0/1; default 1; disabling preserves stored
#                  backgrounds.
#     Default:     1
AzerothVoices.Personality.GenerateBackground = 1

# AzerothVoices.Personality.GenerateTone
#     Description: Traits are compile-time fixed at exactly three. The former
#                  AzerothVoices.Personality.TraitCount option was removed; stored rows
#                  with any other trait count are treated as stale and regenerated
#                  lazily. Generates a persistent speaking tone derived from traits and
#                  background; accepted values 0/1; default 1.
#     Default:     1
AzerothVoices.Personality.GenerateTone = 1

# AzerothVoices.Personality.GenerateOnDemand
#     Description: Generates missing personalities when a PlayerBot first enters an
#                  accepted dialogue request; accepted values 0/1; default 1.
#     Default:     1
AzerothVoices.Personality.GenerateOnDemand = 1

# AzerothVoices.Personality.UseInRandom
#     Description: Uses the persistent PlayerBot personality in random/ambient and
#                  generated-follow-up prompts; accepted values 0/1; default 1.
#     Default:     1
AzerothVoices.Personality.UseInRandom = 1

# AzerothVoices.Personality.UseInEvents
#     Description: Uses the persistent PlayerBot personality in automatic and adapter
#                  event prompts; accepted values 0/1; default 1.
#     Default:     1
AzerothVoices.Personality.UseInEvents = 1

# AzerothVoices.Personality.GenerationRetrySeconds
#     Description: Sets the minimum delay after failed generation before the same bot
#                  can retry; accepted range 10-86400 seconds; default 300.
#     Default:     300
AzerothVoices.Personality.GenerationRetrySeconds = 300

# ---------------------------------------------------------------------------
# BACKGROUND STORY LENGTH & GENERATION CONTROLS
# ---------------------------------------------------------------------------

# AzerothVoices.Personality.BackstorySentences
#     Description: Target sentence count for generated backstories.
#                  - Set to 1 or 2 for short, punchy backstories.
#                  - Set to 3 for compact 3-sentence backstories (ideal for 3-4 sentence biographies).
#                  - Set to 1 or 2 for ultra-short, punchy backstories.
#                  - Set to 0 to disable sentence constraints entirely, letting
#                    token and character limits govern the output.
#     Accepted:    0 - 10 (0 = no sentence constraint / auto)
#     Default:     3
AzerothVoices.Personality.BackstorySentences = 3

# AzerothVoices.Personality.MaxTokens
#     Description: Hard output token limit sent directly to the LLM API for
#                  personality & backstory generation calls.
#                  - Set to 120 for compact 3-4 sentence backstories without rambling.
#                  - Set to 0 for automatic token budgeting based on characters.
#                  - Bypasses reasoning/thinking token inflation so the model
#                    cannot generate long, rambling stories.
#     Accepted:    0 - 2048 (0 = auto)
#     Default:     120
AzerothVoices.Personality.MaxTokens = 120

# AzerothVoices.Personality.MaxBackgroundChars
#     Description: Hard maximum character limit stored in the database and
#                  displayed in the Chatter / Azeroth Voices Companion UI.
#                  - Set to 600 to comfortably fit complete 3-4 sentence backstories
#                    without mid-sentence truncation or ellipsis in the database.
#                  - Set to 0 for unconstrained mode (saves full generated backstory).
#                  - Clamps cleanly at sentence boundaries instead of resetting to defaults.
#     Accepted:    0 - 65535 (0 = auto / unconstrained)
#     Default:     600
AzerothVoices.Personality.MaxBackgroundChars = 600

# AzerothVoices.Personality.MaxPromptChars
#     Description: Bounds personality and background text inserted into each prompt.
#                  - Set to 900 to ensure full voice persona and complete 3-4 sentence
#                    backstory are injected into requests without any ellipsis truncation.
#                  - Set to 0 for automatic mode (accommodates full persona voice
#                    and backstory without artificial prompt character capping).
#     Accepted:    0 - 2000 (0 = auto)
#     Default:     900
AzerothVoices.Personality.MaxPromptChars = 900


# AzerothVoices.Personality.Prompt.Roleplay
#     Description: Compact system guidance prompt used when generating backstories in Roleplay
#                  mode (BackgroundMode=0). Instructs the model to create simple,
#                  lore-appropriate character biographies without poetic or flowery language. (Text.)
#     Default:     Write a simple, compact Vanilla/Turtle WoW backstory with plain facts only. State birthplace, straightforward occupation, and upbringing. Strictly do NOT use poetic, flowery, or dramatic language. Keep it compact with minimal details, and avoid tragic clichés. Return only backstory text.
AzerothVoices.Personality.Prompt.Roleplay = Write a simple, compact Vanilla/Turtle WoW backstory with plain facts only. State birthplace, straightforward occupation, and upbringing. Strictly do NOT use poetic, flowery, or dramatic language. Keep it compact with minimal details, and avoid tragic clichés. Return only backstory text.

# AzerothVoices.Personality.Prompt.Normal
#     Description: Compact system guidance prompt used when generating backstories in Normal
#                  mode (BackgroundMode=1). Instructs the model to create simple,
#                  purely real-life biographical backgrounds (occupation, hometown,
#                  daily routines) with zero poetic phrasing and zero mention of WoW. (Text.)
#     Default:     Write a simple, compact real-world background with plain facts only: everyday job, hometown, and simple routine. Strictly do NOT use poetic, flowery, or dramatic language. Keep it compact with minimal details. Never mention WoW, gaming, or avatars. Return only backstory text.
AzerothVoices.Personality.Prompt.Normal = Write a simple, compact real-world background with plain facts only: everyday job, hometown, and simple routine. Strictly do NOT use poetic, flowery, or dramatic language. Keep it compact with minimal details. Never mention WoW, gaming, or avatars. Return only backstory text.

# AzerothVoices.Personality.Prompt.Traits
#     Description: System guidance prompt used when generating a bot's 3 personality traits.
#                  Instructs the model to select diverse, distinctive quirks and flaws rather
#                  than repetitive generic adjectives. (Text.)
#     Default:     traits must be an array of exactly 3 distinct concise descriptors chosen freely so their combination feels specific, varied, and internally coherent. Avoid repetitive clichés like 'strategic', 'thoughtful', 'introverted', or 'mischievous'. Draw from a wide spectrum of quirks, flaws, temperaments, and social styles (such as hot-headed, boastful, superstitious, thrifty, deadpan, clumsy, blunt, fiercely loyal, sarcastic, or reckless). Do not use a fixed checklist, and do not merely restate race or class.
AzerothVoices.Personality.Prompt.Traits = traits must be an array of exactly 3 distinct concise descriptors chosen freely so their combination feels specific, varied, and internally coherent. Avoid repetitive clichés like 'strategic', 'thoughtful', 'introverted', or 'mischievous'. Draw from a wide spectrum of quirks, flaws, temperaments, and social styles (such as hot-headed, boastful, superstitious, thrifty, deadpan, clumsy, blunt, fiercely loyal, sarcastic, or reckless). Do not use a fixed checklist, and do not merely restate race or class.

# AzerothVoices.Personality.Prompt.Tone
#     Description: System guidance prompt used when generating a bot's persistent speaking style.
#                  Instructs the model to produce varied, natural speech rhythms. (Text.)
#     Default:     tone must be a concise speaking-style description derived from the traits. Avoid clichés like 'passion for storytelling' or 'thoughtful and articulate'. Focus on concrete vocal habits (e.g. blunt and dry, energetic fast-talker, deadpan sarcasm, gruff veteran brevity, cheerful banter, or hesitant caution).
AzerothVoices.Personality.Prompt.Tone = tone must be a concise speaking-style description derived from the traits. Avoid clichés like 'passion for storytelling' or 'thoughtful and articulate'. Focus on concrete vocal habits (e.g. blunt and dry, energetic fast-talker, deadpan sarcasm, gruff veteran brevity, cheerful banter, or hesitant caution).

# --------------------------------------------
# 6. PLAYERBOT-TO-REAL-PLAYER SENTIMENT
# --------------------------------------------
#
# Sentiment is one directional: an AI-controlled PlayerBot actor toward one online real-player
# target. NPC actors, NPC targets, PlayerBot targets, and PlayerBot-to-PlayerBot pairs are rejected.
# The model sees only the C++-derived tier; GMs can inspect the exact -100..100 score. Dialogue
# piggybacks one small hidden delta on the existing provider response, so no second API call is made.
# A valid delta is applied only after the first generated line is delivered successfully. Score
# changes are limited to a real player's direct Whisper, Party with exactly one PlayerBot in the
# subgroup, named Party when several PlayerBots share the subgroup, or named Say/World message.
# Event and Random requests can read the tier when enabled below but never change it. Neutral SQL
# rows older than 90 days are removed by the existing hourly database cleanup.
# --------------------------------------------

# AzerothVoices.Sentiment.Enable
#     Description: Enables bounded sentiment context, updates, lazy decay, cache, and
#                  persistence; accepted values 0/1; default 0.
#     Default:     0
AzerothVoices.Sentiment.Enable = 0

# AzerothVoices.Sentiment.UseInRandom
#     Description: Uses the anchor real player's relationship tier in random/ambient
#                  prompts without changing the score; accepted values 0/1; default 0.
#     Default:     0
AzerothVoices.Sentiment.UseInRandom = 0

# AzerothVoices.Sentiment.UseInEvents
#     Description: Uses the real event subject's relationship tier in event prompts
#                  without changing the score; accepted values 0/1; default 0.
#     Default:     0
AzerothVoices.Sentiment.UseInEvents = 0

# AzerothVoices.Sentiment.ConversationMaximumDelta
#     Description: Hard maximum magnitude for a model-reported qualifying direct player-
#                  chat change; accepted range 0-2; default 2. Zero keeps tier context
#                  but disables dialogue changes.
#     Default:     2
AzerothVoices.Sentiment.ConversationMaximumDelta = 2

# AzerothVoices.Sentiment.InactivityGraceDays
#     Description: Full inactive days before lazy decay can begin; accepted range 0-365;
#                  default 7. No background sweep is performed.
#     Default:     7
AzerothVoices.Sentiment.InactivityGraceDays = 7

# AzerothVoices.Sentiment.PositiveDecayPerDay
#     Description: Positive points removed per full inactive day after the grace period;
#                  accepted range 0-100; default 1.
#     Default:     1
AzerothVoices.Sentiment.PositiveDecayPerDay = 1

# AzerothVoices.Sentiment.NegativeDecayPerDay
#     Description: Negative points moved toward neutral per full inactive day after the
#                  grace period; accepted range 0-100; default 2, so grudges fade faster
#                  than friendship.
#     Default:     2
AzerothVoices.Sentiment.NegativeDecayPerDay = 2

# AzerothVoices.Sentiment.CacheMaximumEntries
#     Description: Maximum lazily loaded relationship pairs in the world-thread RAM hot
#                  cache; accepted range 1-100000; default 4096.
#     Default:     4096
AzerothVoices.Sentiment.CacheMaximumEntries = 4096

# AzerothVoices.Sentiment.PendingWriteMaximum
#     Description: Maximum distinct dirty relationship pairs waiting for SQL; accepted
#                  range 1-100000; default 1024. Repeated changes to one pair are
#                  coalesced.
#     Default:     1024
AzerothVoices.Sentiment.PendingWriteMaximum = 1024

# AzerothVoices.Sentiment.DatabaseFlushSeconds
#     Description: Maximum delay before dirty sentiment upserts are queued; accepted
#                  range 1-3600 seconds; default 5.
#     Default:     5
AzerothVoices.Sentiment.DatabaseFlushSeconds = 5

# AzerothVoices.Sentiment.DatabaseFlushBatchSize
#     Description: Distinct dirty pairs queued per normal flush; accepted range
#                  1-PendingWriteMaximum; default 50, clamped to PendingWriteMaximum
#                  when that cap is lower.
#     Default:     50
AzerothVoices.Sentiment.DatabaseFlushBatchSize = 50

# --------------------------------------------
# 7. PLAYERBOT DELIVERY SCOPES, RESPONSE SELECTION, AND DISTANCES
# --------------------------------------------

# AzerothVoices.Replies.Whisper
#     Description: Enables direct PlayerBot whisper replies.
#     Default:     1
AzerothVoices.Replies.Whisper = 1

# AzerothVoices.Replies.Say
#     Description: Enables PlayerBot Say replies plus eligible NPC ambient/event/combat-
#                  start Say and NPC reactions to human or PlayerBot Say.
#     Default:     1
AzerothVoices.Replies.Say = 1

# AzerothVoices.Replies.Yell
#     Description: Enables PlayerBot Yell replies. Azeroth Voices NPCs never use Yell.
#     Default:     1
AzerothVoices.Replies.Yell = 1

# AzerothVoices.Replies.Party
#     Description: Enables PlayerBot party-subgroup replies.
#     Default:     1
AzerothVoices.Replies.Party = 1

# AzerothVoices.Replies.Raid
#     Description: Enables PlayerBot raid replies.
#     Default:     1
AzerothVoices.Replies.Raid = 1

# AzerothVoices.Replies.Guild
#     Description: Enables guild replies, guild ambient chatter, and guild-scoped event
#                  chatter.
#     Default:     1
AzerothVoices.Replies.Guild = 1

# AzerothVoices.Replies.Officer
#     Description: Enables officer-channel replies for suitably ranked bots.
#     Default:     0
AzerothVoices.Replies.Officer = 0

# AzerothVoices.Replies.World
#     Description: Enables cross-faction replies and ambient lines in WorldChannelName
#                  when the core's two-side channel interaction is enabled. Bot-
#                  originated and random World chatter requires one online real player
#                  anywhere on the server; it does not require channel-membership proof
#                  or proximity.
#     Default:     1
AzerothVoices.Replies.World = 1

# AzerothVoices.Replies.CustomChannels
#     Description: Enables cross-faction replies in channels other than WorldChannelName
#                  when the core's two-side channel interaction is enabled. When set to
#                  1, bot-originated replies retain the conservative public-count gate
#                  because exact individual channel membership is private in this core.
#     Default:     0
AzerothVoices.Replies.CustomChannels = 0

# AzerothVoices.WorldChannelName
#     Description: Used to classify and deliver world-chat messages. (Channel name.)
#     Default:     World
AzerothVoices.WorldChannelName = World

# AzerothVoices.DisableRepliesInCombat
#     Description: Prevents actors currently in combat from being selected when set to
#                  1. Combat replies, including the dedicated combat-start reaction, are
#                  enabled by default.
#     Default:     0
AzerothVoices.DisableRepliesInCombat = 0

# AzerothVoices.MaxResponders
#     Description: Maximum responders to one incoming message. (Actors, minimum 1.)
#     Default:     2
AzerothVoices.MaxResponders = 2

# AzerothVoices.ResponderFalloff.Enable
#     Description: Enables progressive falloff only for responders to one normal non-
#                  whisper incoming chat message; 1 always permits the first
#                  successfully queued responder, then rolls each later responder slot,
#                  while 0 uses only AzerothVoices.MaxResponders. Generated follow-ups
#                  and event responders keep their separate existing settings. Direct
#                  selection/name targeting keeps its existing priority. (Accepted 0/1.)
#     Default:     1
AzerothVoices.ResponderFalloff.Enable = 1

# AzerothVoices.ResponderFalloff.SecondChance
#     Description: Chance to open the second responder slot after one responder was
#                  successfully queued; if the roll passes, candidates are tried until
#                  one queues successfully or none remain. Existing scope, direct-
#                  address, name-mention, NPC, audience, cooldown, and eligibility gates
#                  still apply. (Percentage 0-100.)
#     Default:     50
AzerothVoices.ResponderFalloff.SecondChance = 50

# AzerothVoices.ResponderFalloff.Delta
#     Description: Percentage points removed from each later successfully queued
#                  responder slot: third = SecondChance - Delta, fourth = SecondChance -
#                  2*Delta, floored at 0. (Percentage points 0-100.)
#     Default:     20
AzerothVoices.ResponderFalloff.Delta = 20

# AzerothVoices.SayDistance
#     Description: Local Say listener/responder and real-human observer distance for
#                  PlayerBots and NPCs. PlayerBots never count as observers. Combat-
#                  start reactions require the opening real player to be within this
#                  distance. (Decimal yards, minimum 1.)
#     Default:     25
AzerothVoices.SayDistance = 25

# AzerothVoices.YellDistance
#     Description: Local yell listener/responder distance. Bot-originated yell can
#                  trigger AI replies only when a real player is also within this
#                  distance. (Decimal yards, minimum SayDistance.)
#     Default:     100
AzerothVoices.YellDistance = 100

# AzerothVoices.NameMention.ExclusiveResponder
#     Description: When 1, any full online PlayerBot name explicitly mentioned in Say,
#                  Yell, Party, Raid, Guild, Officer, World, or custom-channel chat
#                  makes only explicitly named PlayerBots eligible; unmentioned
#                  PlayerBots and NPCs are suppressed, while the existing NameMention
#                  chance still decides whether a named bot replies. Whisper is already
#                  single-target. (Accepted 0/1.)
#     Default:     1
AzerothVoices.NameMention.ExclusiveResponder = 1

# AzerothVoices.CandidateScore.DirectTarget
#     Description: Candidate priority base score for an actor directly targeted by the
#                  speaking player or whispered. (Score, 0-200.)
#     Default:     100
AzerothVoices.CandidateScore.DirectTarget = 100

# AzerothVoices.CandidateScore.NameMention
#     Description: Candidate priority base score for an actor whose name is explicitly
#                  mentioned in the message. (Score, 0-100.)
#     Default:     80
AzerothVoices.CandidateScore.NameMention = 80

# AzerothVoices.CandidateScore.Untargeted
#     Description: Candidate priority base score for an untargeted and unmentioned actor
#                  in group or local chat. (Score, 0-100.)
#     Default:     25
AzerothVoices.CandidateScore.Untargeted = 25

# AzerothVoices.Chance.DirectAddress
#     Description: Chance a selected or directly whispered actor answers. (Percentage.)
#     Default:     100
AzerothVoices.Chance.DirectAddress = 100

# AzerothVoices.Chance.NameMention
#     Description: Chance an actor named in the message answers. (Percentage.)
#     Default:     70
AzerothVoices.Chance.NameMention = 70

# AzerothVoices.Chance.Overhear
#     Description: Chance an otherwise eligible nearby actor joins in. (Percentage.)
#     Default:     8
AzerothVoices.Chance.Overhear = 8

# AzerothVoices.Say.ConversationReplyWindowSeconds
#     Description: Time window in seconds where an active /say conversation partner (NPC
#                  or PlayerBot) remains locked for subsequent turns when the player
#                  speaks again without naming another actor. (Seconds, minimum 5.)
#     Default:     45
AzerothVoices.Say.ConversationReplyWindowSeconds = 45

# AzerothVoices.Say.ConversationMaxTurns
#     Description: Maximum consecutive reply turns an active /say conversation partner
#                  will take before requiring re-addressing. (Turns, minimum 1.)
#     Default:     5
AzerothVoices.Say.ConversationMaxTurns = 5

# AzerothVoices.Party.SpeakerRotationPenalty
#     Description: Score penalty applied to the bot that spoke last in party or raid
#                  chat when multiple bots are eligible and none was explicitly named,
#                  ensuring diverse cooperative replies. (Percentage, 0-100.)
#     Default:     60
AzerothVoices.Party.SpeakerRotationPenalty = 60

# AzerothVoices.PlayerReplyChance.Say
#     Description: Bot response chance to a real player's say/yell. (Percentage.)
#     Default:     90
AzerothVoices.PlayerReplyChance.Say = 90

# AzerothVoices.BotReplyChance.Say
#     Description: Bot response chance to another bot's say/yell. (Percentage.)
#     Default:     10
AzerothVoices.BotReplyChance.Say = 10

# AzerothVoices.PlayerReplyChance.Channel
#     Description: Bot response chance to a real player in world/custom chat.
#                  (Percentage.)
#     Default:     60
AzerothVoices.PlayerReplyChance.Channel = 60

# AzerothVoices.BotReplyChance.Channel
#     Description: Bot response chance to another bot in world/custom chat. Bot-
#                  originated channel replies also require the module to prove from
#                  public core counts that the channel has a real member. (Percentage.)
#     Default:     3
AzerothVoices.BotReplyChance.Channel = 3

# AzerothVoices.PlayerReplyChance.Party
#     Description: Bot response chance to a real player in party/raid. (Percentage.)
#     Default:     90
AzerothVoices.PlayerReplyChance.Party = 90

# AzerothVoices.PlayerReplyChance.TargetActive.Enable
#     Description: When enabled, if a human player has an active target in Say, Yell,
#                  Party, or Raid chat, untargeted companion bots suppress their reply
#                  probability to TargetActive.Chance instead of full ambient channel
#                  rates. Global channels (Guild, Officer, World) skip target
#                  suppression.
#     Default:     1
AzerothVoices.PlayerReplyChance.TargetActive.Enable = 1

# AzerothVoices.PlayerReplyChance.TargetActive.Chance
#     Description: Bot response chance when the speaking player has an active target
#                  (applies to untargeted bots in Say, Yell, Party, Raid). (Percentage,
#                  0-100.)
#     Default:     60
AzerothVoices.PlayerReplyChance.TargetActive.Chance = 60

# AzerothVoices.BotReplyChance.Party
#     Description: Bot response chance to another bot in party/raid. Bot-originated
#                  replies also require a real member in the party subgroup or raid.
#                  (Percentage.)
#     Default:     5
AzerothVoices.BotReplyChance.Party = 5

# AzerothVoices.PlayerReplyChance.Guild
#     Description: Bot response chance to a real player in guild/officer chat.
#                  (Percentage.)
#     Default:     70
AzerothVoices.PlayerReplyChance.Guild = 70

# AzerothVoices.BotReplyChance.Guild
#     Description: Bot response chance to another bot in guild/officer chat. Bot-
#                  originated replies also require a real member with listening rights.
#                  (Percentage.)
#     Default:     5
AzerothVoices.BotReplyChance.Guild = 5

# AiPlayerbot.LLMBotToBotChatChance
#     Description: Global upper cap for PlayerBot-to-PlayerBot replies. Bot-to-bot
#                  whisper is disabled; every other scope requires a real audience.
#                  (Percentage.)
#     Default:     10
AiPlayerbot.LLMBotToBotChatChance = 10

# AiPlayerbot.LLMRpgAIChatChance
#     Description: Upper cap for NPC reactions to PlayerBot Say and for generated
#                  follow-ups where either participant is an NPC. These interactions
#                  remain in Say and require a real human within SayDistance.
#                  (Percentage.)
#     Default:     30
AiPlayerbot.LLMRpgAIChatChance = 30

# AzerothVoices.CommandBlacklist
#     Description: Messages beginning with any listed PlayerBots command or addon prefix
#                  are never sent to the provider; add local prefixes as needed. (Comma-
#                  separated case-insensitive prefixes.)
AzerothVoices.CommandBlacklist = .,!,/,#,$,autogear,talents,summon,release,revive,attack,follow,stay,cast,quest,trainer,teleport,addon,DBM,Recount,Questie

# AzerothVoices.CommandIgnoreList
#     Description: Additional list of ignored command tokens, strategy commands, or
#                  prefixes. (Comma-separated case-insensitive prefixes.)
#     Default:     empty
AzerothVoices.CommandIgnoreList = 

# --------------------------------------------
# 8. NPC DIALOGUE: REACTIONS, COMBAT-START, AND THE ORDERED /SAY REPLY CHAIN
# --------------------------------------------

# AzerothVoices.NPC.Enable
#     Description: Allows eligible static NPCs to react to human or PlayerBot Say, to
#                  nearby events, and to a fresh combat opening. Ordinary ambient Say
#                  chatter is owned by the Proximity section below and classified
#                  dungeon/raid bosses are owned by the Boss Dialogue section, so this
#                  switch does not gate either of those. Neutral and hostile categories
#                  are enabled through the combined switch below. Pet, summon, guardian,
#                  totem, charmed, trigger, critter, and temporary speakers remain
#                  rejected. NPC output is Say only.
#     Default:     1
AzerothVoices.NPC.Enable = 1

# AzerothVoices.NPC.Distance
#     Description: NPC candidate search radius around the local event subject,
#                  human/PlayerBot speaker, or random real-player anchor. It is also the
#                  maximum actor-to-actor distance for every generated follow-up pair
#                  containing an NPC. Both follow-up actors must share one real-human
#                  observer within SayDistance. (Decimal yards, minimum 1.)
#     Default:     10
AzerothVoices.NPC.Distance = 10

# AzerothVoices.NPC.AllowedTypes
#     Description: Creature types eligible for generated NPC speech. Defaults to
#                  Dragonkin, Demon, Elemental, Giant, Undead, Humanoid, and Mechanical;
#                  all NPC safety, faction, audience, distance, and combat checks still
#                  apply. The Proximity section below is stricter and accepts only
#                  humanoids unless an entry is listed in
#                  Proximity.Speaker.AllowNonHumanoidEntries. (Comma-separated
#                  creature_template.type values 0-11.)
#     Default:     2,3,4,5,6,7,9
AzerothVoices.NPC.AllowedTypes = 2,3,4,5,6,7,9

# AzerothVoices.NPC.AllowNeutralAndHostile
#     Description: Allows both neutral and hostile NPC categories through the faction
#                  gate. This does not bypass AllowedTypes or the existing ownership,
#                  temporary-creature, audience, distance, or combat rules.
#     Default:     1
AzerothVoices.NPC.AllowNeutralAndHostile = 1

# AzerothVoices.NPC.ReplyChance.Friendly
#     Description: The three disposition chances below are an additional probability
#                  gate alongside the direct-address, name-mention, overhear, event,
#                  random, and follow-up chances. They apply to those normal NPC-
#                  speaking paths and never bypass NPC safety, faction, distance,
#                  audience, or combat checks. The dedicated combat-start path uses its
#                  own chance below instead. Chance that an otherwise selected NPC
#                  friendly toward the current conversational counterpart speaks.
#                  (Percentage.)
#     Default:     100
AzerothVoices.NPC.ReplyChance.Friendly = 100

# AzerothVoices.NPC.ReplyChance.Neutral
#     Description: Chance that an otherwise selected NPC neutral toward the current
#                  conversational counterpart speaks. (Percentage.)
#     Default:     50
AzerothVoices.NPC.ReplyChance.Neutral = 50

# AzerothVoices.NPC.ReplyChance.Hostile
#     Description: Chance that an otherwise selected NPC hostile or unfriendly toward
#                  the current conversational counterpart speaks. (Percentage.)
#     Default:     25
AzerothVoices.NPC.ReplyChance.Hostile = 25

# AzerothVoices.NPC.CombatStart.Enable
#     Description: Enables one generated Say reaction from the exact creature a real
#                  player attacks when that attack opens a fresh combat. Attacking
#                  another creature while the player remains in the same combat never
#                  creates another combat-start reaction. Existing NPC
#                  safety/type/faction gates and DisableRepliesInCombat still apply.
#     Default:     1
AzerothVoices.NPC.CombatStart.Enable = 1

# AzerothVoices.NPC.CombatStart.Chance
#     Description: Chance that the exact opening creature produces its one combat-start
#                  reaction. The roll happens once per fresh combat. (Percentage.)
#     Default:     30
AzerothVoices.NPC.CombatStart.Chance = 30

# AzerothVoices.NPC.CombatStart.CooldownSeconds
#     Description: Minimum time between accepted combat-start creature reactions for the
#                  same real player; this is separate from the one-trigger-per-combat
#                  latch. (Seconds, minimum 0.)
#     Default:     60
AzerothVoices.NPC.CombatStart.CooldownSeconds = 60

# AzerothVoices.NPC.TargetedConversation.BotComments.Enable
#     Description: A real player who speaks in Say gets one ordered reply chain: an
#                  eligible named NPC (a full-name match beats a unique first-token
#                  match, and an ambiguous name selects nothing), then the explicitly
#                  selected target, then the last active proximity-scene participant,
#                  then a new proximity scene. The chosen speaker answers directly and
#                  is not gated by a separate chance; the usual eligibility, distance,
#                  line-of-sight, cooldown, and queue rules still apply. Every
#                  participant keeps that real player as its SayDistance observer.
#                  Enables observer comments from nearby PlayerBots when a real player
#                  speaks to a targeted NPC.
#     Default:     1
AzerothVoices.NPC.TargetedConversation.BotComments.Enable = 1

# AzerothVoices.NPC.TargetedConversation.BotCommentChance
#     Description: Chance that nearby PlayerBots generate an observer comment when a
#                  real player speaks to a targeted NPC. (Percentage.)
#     Default:     15
AzerothVoices.NPC.TargetedConversation.BotCommentChance = 15

# AzerothVoices.NPC.TargetedConversation.MaxBotComments
#     Description: Maximum number of PlayerBots allowed to make an observer comment per
#                  player-to-NPC interaction. (Integer 0-10.)
#     Default:     1
AzerothVoices.NPC.TargetedConversation.MaxBotComments = 1

# AzerothVoices.NPC.MentionSuppressesDirectBotReply
#     Description: Suppresses direct PlayerBot replies in /say when a real player
#                  mentions or speaks to an NPC. This prevents PlayerBots from answering
#                  questions intended for NPCs or impersonating vendors/questgivers.
#     Default:     1
AzerothVoices.NPC.MentionSuppressesDirectBotReply = 1

# AzerothVoices.NPC.MentionBotDirectReplyChance
#     Description: If direct PlayerBot replies are not completely suppressed when
#                  speaking to an NPC, this sets the chance (0-100%) that a bot is
#                  permitted to reply directly as addressee. (Percentage.)
#     Default:     0
AzerothVoices.NPC.MentionBotDirectReplyChance = 0

# AzerothVoices.NPC.ReplyObserver.Enable
#     Description: Enables observer comments from nearby PlayerBots when an NPC delivers
#                  a reply to a real player. Allows nearby bots to react in-character to
#                  what the NPC said.
#     Default:     1
AzerothVoices.NPC.ReplyObserver.Enable = 1

# AzerothVoices.NPC.ReplyObserver.Chance
#     Description: Chance that nearby PlayerBots generate an observer reaction to the
#                  NPC's answer. (Percentage.)
#     Default:     25
AzerothVoices.NPC.ReplyObserver.Chance = 25

# AzerothVoices.NPC.ReplyObserver.CooldownSeconds
#     Description: Cooldown between bot observer comments reacting to NPC interactions.
#                  (Seconds, 0-86400.)
#     Default:     30
AzerothVoices.NPC.ReplyObserver.CooldownSeconds = 30

# AzerothVoices.TargetedBot.Observer.Enable
#     Description: Enables observer commentary from companion PlayerBots when a real
#                  player speaks to or interacts with a targeted companion PlayerBot.
#                  Allows other party members to chime in or react.
#     Default:     1
AzerothVoices.TargetedBot.Observer.Enable = 1

# AzerothVoices.TargetedBot.CommentOnPlayerChance
#     Description: Chance that an untargeted companion PlayerBot comments on what the
#                  real player said to the targeted bot. (Percentage, 0-100.)
#     Default:     70
AzerothVoices.TargetedBot.CommentOnPlayerChance = 70

# AzerothVoices.TargetedBot.CommentOnReplyChance
#     Description: Chance that an untargeted companion PlayerBot reacts to the reply
#                  delivered by the targeted bot. (Percentage, 0-100.)
#     Default:     30
AzerothVoices.TargetedBot.CommentOnReplyChance = 30

# AzerothVoices.TargetedBot.ObserverCooldownSeconds
#     Description: Cooldown between companion bot observer comments reacting to targeted
#                  bot interactions. (Seconds, 0-86400.)
#     Default:     30
AzerothVoices.TargetedBot.ObserverCooldownSeconds = 30

# --------------------------------------------
# 9. DEDICATED PROXIMITY CHATTER (ORDINARY SAY)
# --------------------------------------------

# AzerothVoices.Proximity.Enable
#     Description: Enables the proximity subsystem, which owns ordinary nearby NPC Say
#                  chatter. Battlegrounds and arenas are always excluded.
#     Default:     1
AzerothVoices.Proximity.Enable = 1

# AzerothVoices.Proximity.ScanSecondsOutdoor
#     Description: Delay between outdoor proximity scans. (Seconds, 5-3600.)
#     Default:     30
AzerothVoices.Proximity.ScanSecondsOutdoor = 30

# AzerothVoices.Proximity.ScanSecondsInstance
#     Description: Delay between dungeon/raid proximity scans. (Seconds, 5-3600.)
#     Default:     30
AzerothVoices.Proximity.ScanSecondsInstance = 30

# AzerothVoices.Proximity.OutdoorChance
#     Description: Trigger chance per outdoor scan, before zone fatigue. (Percentage.)
#     Default:     15
AzerothVoices.Proximity.OutdoorChance = 15

# AzerothVoices.Proximity.InstanceChance
#     Description: Trigger chance per dungeon/raid scan, before zone fatigue.
#                  (Percentage.)
#     Default:     75
AzerothVoices.Proximity.InstanceChance = 75

# AzerothVoices.Proximity.IncludeInstances
#     Description: Includes dungeons and raids; they are never required for outdoor
#                  chatter.
#     Default:     1
AzerothVoices.Proximity.IncludeInstances = 1

# AzerothVoices.Proximity.EntityCooldownSeconds
#     Description: Per-speaker cooldown after a delivered proximity line. (Seconds,
#                  0-86400.)
#     Default:     60
AzerothVoices.Proximity.EntityCooldownSeconds = 60

# AzerothVoices.Proximity.ZoneFatigueScenes
#     Description: Scenes a zone may produce before its trigger chance starts decaying.
#                  (Scenes, 1-100.)
#     Default:     3
AzerothVoices.Proximity.ZoneFatigueScenes = 3

# AzerothVoices.Proximity.ZoneFatigueDecayPercent
#     Description: Decay applied per scene beyond ZoneFatigueScenes and per scene-free
#                  scan, floored at 1 percent. (Percentage.)
#     Default:     20
AzerothVoices.Proximity.ZoneFatigueDecayPercent = 20

# AzerothVoices.Proximity.MinimumSpeakers
#     Description: Minimum speakers selected per scene. (Speakers, 1-8.)
#     Default:     1
AzerothVoices.Proximity.MinimumSpeakers = 1

# AzerothVoices.Proximity.MaximumSpeakers
#     Description: Maximum speakers selected per scene; raised to MinimumSpeakers when
#                  set lower. (Speakers, 1-8.)
#     Default:     3
AzerothVoices.Proximity.MaximumSpeakers = 3

# AzerothVoices.Proximity.ConversationChance
#     Description: Chance a scene becomes a multi-line conversation instead of one line.
#                  (Percentage.)
#     Default:     40
AzerothVoices.Proximity.ConversationChance = 40

# AzerothVoices.Proximity.MaximumLines
#     Description: Lines a single scene may deliver. (Lines, 1-12.)
#     Default:     4
AzerothVoices.Proximity.MaximumLines = 4

# AzerothVoices.Proximity.TurnGapSeconds
#     Description: Minimum gap between delivered lines of one conversation. (Seconds,
#                  0-600.)
#     Default:     3
AzerothVoices.Proximity.TurnGapSeconds = 3

# AzerothVoices.Proximity.ReplyWindowSeconds
#     Description: Window in which a conversation may continue after its first line.
#                  (Seconds, 1-600.)
#     Default:     30
AzerothVoices.Proximity.ReplyWindowSeconds = 30

# AzerothVoices.Proximity.MaximumReplyTurns
#     Description: Generated reply turns allowed inside one scene. (Turns, 1-20.)
#     Default:     5
AzerothVoices.Proximity.MaximumReplyTurns = 5

# AzerothVoices.Proximity.Speaker.AllowEntries
#     Description: Creature entries allowed to speak in proximity scenes; empty means no
#                  entry restriction. The denylist below always wins. (Comma-separated
#                  creature entries.)
#     Default:     empty
AzerothVoices.Proximity.Speaker.AllowEntries = 

# AzerothVoices.Proximity.Speaker.DenyEntries
#     Description: Creature entries that may never speak in proximity scenes, whatever
#                  else qualifies them. (Comma-separated creature entries.)
#     Default:     empty
AzerothVoices.Proximity.Speaker.DenyEntries = 

# AzerothVoices.Proximity.Speaker.AllowNonHumanoidEntries
#     Description: Non-humanoid creature entries explicitly allowed to speak; humanoids
#                  never need to be listed. (Comma-separated creature entries.)
#     Default:     empty
AzerothVoices.Proximity.Speaker.AllowNonHumanoidEntries = 

# --------------------------------------------
# 10. BOSS AND MINIBOSS PRE-AGGRO DIALOGUE (DUNGEONS AND RAIDS ONLY)
# --------------------------------------------

# AzerothVoices.BossDialogue.Enable
#     Description: Enables pre-aggro boss dialogue. Bosses are classified from the
#                  built-in curated registry plus the world-boss rank and instance-bind
#                  fallbacks, and are excluded from ordinary proximity, event, and
#                  combat-start NPC generation so boss speech has exactly one owner.
#     Default:     1
AzerothVoices.BossDialogue.Enable = 1

# AzerothVoices.BossDialogue.ScanSeconds
#     Description: Delay between boss-presence scans. (Seconds, 1-300.)
#     Default:     2
AzerothVoices.BossDialogue.ScanSeconds = 2

# AzerothVoices.BossDialogue.MaximumDistance
#     Description: Maximum distance at which a boss may notice the approaching player.
#                  (Yards, 5-200.)
#     Default:     80
AzerothVoices.BossDialogue.MaximumDistance = 80

# AzerothVoices.BossDialogue.AggroMargin
#     Description: Extra safety margin added to the boss's own attack distance; a boss
#                  never speaks inside this radius. Nothing here alters threat, aggro,
#                  facing, or movement. (Yards, 0-50.)
#     Default:     5
AzerothVoices.BossDialogue.AggroMargin = 5

# AzerothVoices.BossDialogue.InitialDelayMinimumSeconds
#     Description: Lower bound of the initial delay after a boss presence is first
#                  observed. (Seconds, 0-600.)
#     Default:     2
AzerothVoices.BossDialogue.InitialDelayMinimumSeconds = 2

# AzerothVoices.BossDialogue.InitialDelayMaximumSeconds
#     Description: Upper bound of the initial delay; raised to the minimum when set
#                  lower. (Seconds, 0-600.)
#     Default:     6
AzerothVoices.BossDialogue.InitialDelayMaximumSeconds = 6

# AzerothVoices.BossDialogue.RepeatDelayMinimumSeconds
#     Description: Lower bound of the delay before the next automatic line. (Seconds,
#                  1-3600.)
#     Default:     20
AzerothVoices.BossDialogue.RepeatDelayMinimumSeconds = 20

# AzerothVoices.BossDialogue.RepeatDelayMaximumSeconds
#     Description: Upper bound of that delay; raised to the minimum when set lower.
#                  (Seconds, 1-3600.)
#     Default:     60
AzerothVoices.BossDialogue.RepeatDelayMaximumSeconds = 60

# AzerothVoices.BossDialogue.RepeatChance
#     Description: Chance an automatic opportunity produces a line. (Percentage.)
#     Default:     80
AzerothVoices.BossDialogue.RepeatChance = 80

# AzerothVoices.BossDialogue.RepeatChanceDecayPercent
#     Description: Decay applied to the repeat chance after each delivered automatic
#                  line. (Percentage.)
#     Default:     50
AzerothVoices.BossDialogue.RepeatChanceDecayPercent = 50

# AzerothVoices.BossDialogue.RepeatChanceFloor
#     Description: Lowest repeat chance an ongoing presence decays to. (Percentage.)
#     Default:     10
AzerothVoices.BossDialogue.RepeatChanceFloor = 10

# AzerothVoices.BossDialogue.PresenceResetSeconds
